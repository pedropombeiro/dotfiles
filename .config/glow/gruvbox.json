{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#ebdbb2",
    "margin": 2
  },
  "block_quote": {
    "color": "#a89984",
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#83a598", "bold": true },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#282828",
    "background_color": "#fabd2f",
    "bold": true
  },
  "h2": { "prefix": "## " },
  "h3": { "prefix": "### " },
  "h4": { "prefix": "#### " },
  "h5": { "prefix": "##### " },
  "h6": { "prefix": "###### " },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true, "color": "#d3869b" },
  "strong": { "bold": true, "color": "#fabd2f" },
  "hr": { "color": "#665c54", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#83a598", "underline": true },
  "link_text": { "color": "#8ec07c", "bold": true },
  "image": { "color": "#83a598", "underline": true },
  "image_text": { "color": "#a89984", "format": "Image: {{.text}} →" },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#fabd2f",
    "background_color": "#3c3836"
  },
  "code_block": {
    "color": "#ebdbb2",
    "margin": 2,
    "chroma": {
      "text": { "color": "#ebdbb2" },
      "error": { "color": "#ebdbb2", "background_color": "#cc241d" },
      "comment": { "color": "#928374" },
      "comment_preproc": { "color": "#fe8019" },
      "keyword": { "color": "#fb4934" },
      "keyword_reserved": { "color": "#fb4934" },
      "keyword_namespace": { "color": "#fb4934" },
      "keyword_type": { "color": "#fabd2f" },
      "operator": { "color": "#fe8019" },
      "punctuation": { "color": "#ebdbb2" },
      "name": { "color": "#ebdbb2" },
      "name_builtin": { "color": "#fabd2f" },
      "name_tag": { "color": "#83a598" },
      "name_attribute": { "color": "#b8bb26" },
      "name_class": { "color": "#fabd2f" },
      "name_constant": { "color": "#d3869b" },
      "name_decorator": { "color": "#8ec07c" },
      "name_exception": {},
      "name_function": { "color": "#b8bb26" },
      "name_other": {},
      "literal": {},
      "literal_number": { "color": "#d3869b" },
      "literal_date": {},
      "literal_string": { "color": "#b8bb26" },
      "literal_string_escape": { "color": "#8ec07c" },
      "generic_deleted": { "color": "#fb4934" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#b8bb26" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#83a598" },
      "background": { "background_color": "#282828" }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
