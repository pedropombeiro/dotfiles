{
  "servers": [
    {
      "name": "context7",
      "description": "Library documentation and code examples",
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"]
    },
    {
      "name": "websearch",
      "description": "Web search via Exa AI",
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa"
    },
    {
      "name": "grep_app",
      "description": "GitHub code search via grep.app",
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    {
      "name": "memos",
      "description": "Personal notes and memos via Memos",
      "type": "remote",
      "url": "https://memos.pombei.ro/mcp",
      "headers": {
        "Authorization": "Bearer {file:~/.config/lazy-mcp/memos-token}"
      }
    }
  ]
}
