{
{% if yadm.class == "Work" %}
  "requestTimeout": 120000,
{% endif %}
  "servers": [
{% if yadm.class == "NAS" %}
    {
      "name": "grafana",
      "description": "Read-only NAS Grafana dashboards, alerts, Prometheus metrics, Loki logs, and Tempo traces",
      "type": "local",
      "command": [
        "mise", "x", "github:grafana/mcp-grafana", "--", "mcp-grafana",
        "--transport=stdio", "--disable-write",
        "--enabled-tools=search,datasource,prometheus,loki,tempo,alerting,dashboard,folder,navigation",
        "--usage-stats=disabled"
      ],
      "env": {
        "GRAFANA_URL": "https://grafana.pombei.ro",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN_FILE": "${HOME}/.config/lazy-mcp/grafana-token",
        "GOMEMLIMIT": "192MiB"
      }
    },
{% endif %}
{% if yadm.class == "Work" %}
    {
      "name": "gitlab",
      "description": "GitLab MCP server",
      "url": "https://gitlab.com/api/v4/mcp",
      "type": "remote"
    },
    {
      "name": "gitlab-orbit",
      "description": "GitLab repository knowledge graph and code analysis",
      "type": "local",
      "command": ["npx", "mcp-remote", "https://gitlab.com/api/v4/orbit/mcp"]
    },
    {
      "name": "pinchtab",
      "description": "Browser control for AI agents via PinchTab",
      "type": "local",
      "command": ["pinchtab", "mcp"]
    },
    {
      "name": "glean_default",
      "description": "GitLab enterprise search and knowledge discovery via Glean",
      "type": "remote",
      "url": "https://gitlab-be.glean.com/mcp/default",
      "oauth": {
        "callbackPort": 53900
      }
    },
    {
      "name": "incident_io",
      "description": "Gitlab.com incident management tool",
      "type": "local",
      "command": ["/Users/pedropombeiro/.incidentio/incident", "mcp"]
    },
    {
      "name": "gitlab-observability",
      "description": "GitLab Observability metrics, logs, and traces (https://docs.gitlab.com/operations/observability/mcp_server/)",
      "type": "remote",
      "url": "https://9970.mcp.gitlab-o11y.com/mcp",
      "oauth": false,
      "headers": {
        "SIGNOZ-API-KEY": "${GITLAB_OBSERVABILITY_API_KEY}"
      }
    },
    {
      "name": "esquery",
      "description": "GitLab production logs (Kibana log.gprd.gitlab.net) through the Kibana SSO session. RED data.",
      "type": "local",
      "command": ["mise", "x", "gitlab:gitlab-com/gl-infra/esquery", "--", "esquery", "mcp"],
      "env": {
        "KIBANA_URL": "https://log.gprd.gitlab.net"
      }
    },
    {
      "name": "esquery-staging",
      "description": "GitLab staging and nonprod logs (Kibana nonprod-log.gitlab.net) through the Kibana SSO session",
      "type": "local",
      "command": ["mise", "x", "gitlab:gitlab-com/gl-infra/esquery", "--", "esquery", "mcp"],
      "env": {
        "KIBANA_URL": "https://nonprod-log.gitlab.net"
      }
    },
    {
      "name": "clickhouse",
      "description": "DevEx analytics ClickHouse (CI, test, coverage, and work item metrics): list databases and tables, run SELECT queries",
      "type": "local",
      "command": ["mise", "x", "uv", "--", "uv", "run", "--with", "mcp-clickhouse", "--python", "3.13", "mcp-clickhouse"],
      "env": {
        "CLICKHOUSE_HOST": "gltxq8v2en.us-east1.gcp.clickhouse.cloud",
        "CLICKHOUSE_PORT": "8443",
        "CLICKHOUSE_USER": "{file:~/.config/lazy-mcp/clickhouse-username}",
        "CLICKHOUSE_PASSWORD": "{file:~/.config/lazy-mcp/clickhouse-password}",
        "CLICKHOUSE_SECURE": "true",
        "CLICKHOUSE_VERIFY": "true"
      }
    },
{% endif %}
{% if yadm.class != "NAS" %}
    {
      "name": "websearch",
      "description": "Web search via Exa AI",
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa"
    },
    {
      "name": "grep_app",
      "description": "GitHub code search via grep.app",
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    {
      "name": "memos",
      "description": "Personal notes and memos via Memos",
      "type": "remote",
      "url": "https://memos.pombei.ro/mcp",
      "headers": {
        "Authorization": "Bearer {file:~/.config/lazy-mcp/memos-token}"
      }
    },
{% endif %}
{% if yadm.class == "Personal" %}
    {
      "name": "garmin",
      "description": "Create and schedule Garmin Connect workouts (including nested repeat blocks) and read the workout library and calendar. Bulk delete and unschedule tools are disabled; single-item ones are enabled and need approval",
      "type": "local",
      "command": [
        "mise", "x", "uv", "--", "uv", "run", "--frozen", "--no-dev", "--python", "3.12",
        "--project", "{{ env.HOME }}/Developer/github.com/Taxuspt/garmin_mcp",
        "garmin-mcp"
      ],
      "env": {
        "GARMIN_TOOL_PROFILE": "workouts",
        "GARMIN_DISABLED_TOOLS": "delete_workouts,unschedule_workouts"
      }
    },
{% endif %}
    {
      "name": "context7",
      "description": "Library documentation and code examples",
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"]
    }
  ]
}
