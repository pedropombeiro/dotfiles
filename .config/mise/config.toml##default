redactions = ["*_API_KEY", "*_TOKEN"]

[env]
_.source = { path = ".config/mise/.github_token.sh", redact = true }

[settings]
jobs = 1
idiomatic_version_file_enable_tools = []

[settings.pipx]
uvx = true

[tools]
# ── Runtimes & infra ──────────────────────────────────────────────────
# JavaScript runtime
node = "latest"
# Ruby runtime is declared per class, not here: the work machine resolves `ruby`
# through GitLab's asdf-gitlab-ruby plugin, which publishes no macos/arm64 build
# past 3.4.9, while personal uses core:ruby and can track newer releases.
# See conf.d/work.toml##class.Work and conf.d/personal.toml##class.Personal.
# Rust toolchain
rust = "stable"
# cURL-like tool for gRPC servers
grpcurl = "latest"
# YAML linter
yamllint = "latest"

# ── AI tooling ────────────────────────────────────────────────────

# AI coding assistant CLI
"opencode" = { version = "latest", no_app = true }
# A CLI tool for tracking token usage
"npm:tokscale" = "latest"

# ── Automation ────────────────────────────────────────────────────────
# Automated dependency update bot. Shared rather than per-class: the hk
# `renovate-config-validator` step runs `mise x npm:renovate` on any machine
# that commits a change to a *renovate* file, so the pin must resolve everywhere.
# Trust-policy exception: @yarnpkg/libzip@3.2.2 (transitive via @yarnpkg/core)
# lost the npm provenance that 3.2.0/3.2.1 carried. Upstream cause: the release
# came from a cherry-pick branch lacking `npmPublishProvenance: true`, so the
# whole 16-package batch (fslib@3.1.3, core@4.4.4, ...) published unattested.
# Audited 2026-08-02: tarball sha1/sha512 match registry metadata; diff vs 3.2.1
# is a 3-line `parentPath` fix plus .d.ts type churn; .wasm blobs byte-identical;
# no install scripts. Not exploitable-looking; this is release-process drift.
# Upstream: https://github.com/yarnpkg/berry/issues/7182
# REMOVE this exclusion once libzip ships a provenance-bearing release (>3.2.2).
#
# allow_builds: re2 is an optional native dep. aube denies dependency build
# scripts by default, so without this its .node binary is never built and every
# renovate invocation warns "RE2 not usable, falling back to RegExp", which
# also makes regex validation less accurate than the real run in CI/Docker.
# re2 is a Google-maintained binding built from source here; no postinstall
# beyond the compile step.
"npm:renovate" = { version = "44.35.3", trust_policy_excludes = [
  "@yarnpkg/libzip@3.2.2",
], allow_builds = [
  "re2",
] }

# ── GitHub releases ───────────────────────────────────────────────────
# Terminal file manager
"github:sxyazi/yazi" = "26.8.15"

# ── Ruby gems ─────────────────────────────────────────────────────────
# Ruby provider for Neovim plugins
"gem:neovim" = "0.10.0"
# Ruby LSP language server
"gem:ruby-lsp" = "0.26.11"
# Ruby linter/formatter (StandardRB)
"gem:standard" = "latest"

# ── Neovim integration ────────────────────────────────────────────────
# Open files in an existing Neovim instance
"pipx:neovim-remote" = "2.5.1"

# ── Video editing tools ────────────────────────────────────────────────
# Programs to process GoPro MP4 & Generic GPX/FIT files and create video dashboards & maps
# Personal fork adds whole-ride extent for the journey map & elevation chart
# (journey_map extent="ride", chart range="ride"), now merged to the fork's main.
# Pinned to a fork release, not a branch: mise's pipx git backend resolves
# versions from GitHub *releases* only, so a branch pin makes `mise upgrade` warn
# "no latest version found". Tags carry a -whole-ride.N suffix so they never
# collide with a future upstream v0.134.0.
"pipx:git+https://github.com/pedropombeiro/gopro-dashboard-overlay.git" = "v0.134.0-whole-ride.1"

# ── Brew ──────────────────────────────────────────────────────────────

[tasks."brew:dump"]
description = "Dump current Homebrew packages to Brewfile"
run = "brew bundle dump --global --force --formula --cask --tap"

[tasks."brew:cleanup"]
description = "Remove packages not in Brewfile"
run = "brew bundle cleanup --file ~/.Brewfile --force"

# ── Network ───────────────────────────────────────────────────────────

[tasks."network:wifi-traffic"]
description = "Sniff Wi-Fi traffic from the AP"
run = 'ssh ap-u6pro.infra.pombei.ro "tcpdump -np"'
