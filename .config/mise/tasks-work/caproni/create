#!/usr/bin/env sh
#MISE description="Create an isolated Caproni environment for a work item"
#USAGE arg "<work-item-id>" help="Numeric GitLab work item or issue IID"
#USAGE arg "[branch-description]" help="Short branch description" default="work"
set -eu

# mise defines usage_* variables from the #USAGE directives.
# shellcheck disable=SC2154
"$HOME/.agents/skills.work/caproni/scripts/create-env.sh" "$usage_work_item_id" "$usage_branch_description"
# shellcheck source=/dev/null
. "$HOME/.config/yadm/scripts/lib/link-duo-defaults.sh"
caproni_root=${CAPRONI_ENV_ROOT:-$HOME}
link_duo_defaults "${caproni_root%/}/cap-$usage_work_item_id"
