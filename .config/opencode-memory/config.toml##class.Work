[identity]
# user = "your-gitlab-username"  # Auto-detected from git if not set
instance = "gitlab.com"

[boot]
identity = true
active_sessions = true
hot_items = true
unresolved_blockers = true
recent_decisions = false
max_hot_items = 5

[ingestion]
# Directories are watched recursively for *.md (watcher.py defaults to {".md"});
# a *.db entry is instead polled as the OpenCode session store. The brain dir is
# the second-brain half of the weekly-log loop (pedropombeiro/weekly-log,
# personal fork of gitlab-org/growth/ai/weekly-log-template), so weekly entries
# are ingested as they land. Absolute-ish path is fine here -- this file is
# already a ##class.Work alt for machine-specific paths.
watch_paths = [
  "~/.local/share/opencode/opencode.db",
  "~/Developer/gitlab.com/pedropombeiro/weekly-log/brain",
]
db_poll_interval = 30
# LLM-based knowledge extraction from old conversations. Uses 'opencode run'
# per conversation (every 6h, up to 50 per cycle) and WILL incur API costs.
# Disabled 2026-07-29: the curated second-brain loop above is now the source of
# durable knowledge, so paying an LLM to mine old transcripts is redundant.
# Note this flag also gates CONTRADICTS link detection in linking/linker.py --
# acceptable here since it had produced 0 such links (only extends/related/
# same_entity, which are non-LLM). Passive session ingestion is unaffected;
# it is governed by `enabled`, not this flag.
llm_extraction = false

[storage]
path = "~/.local/share/opencode-memory"

# Opt-in auto-updates (#152). OFF by default. When enabled the background
# worker periodically checks the chosen channel and, per the tiered consent
# below, may apply updates and restart the services automatically.
#   channel = "stable" tracks release tags; "edge" tracks master commits.
#   Patch (x.y.Z) can auto-apply; minor (x.Y.0) and major (X.0.0) ask first
#   via workflow(action="update_apply"). Rollback is always available via
#   workflow(action="rollback"). On edge there is no tier: auto_patch governs
#   whether new commits auto-apply.
[update]
enabled = false
channel = "stable"
auto_patch = false
auto_minor = false
auto_major = false
check_interval_seconds = 86400
# pin = "0.12.0"   # never auto-apply beyond this version
keep_backups = 3

[setup]
startup = "always"
agents = "opencode,claude"
runtime = "python"

[llm]
provider = "opencode"
# Absolute path: the launchd LaunchAgents set no PATH, so the mise shim dir is
# not on the services' PATH and shutil.which("opencode") fails there. Setting
# `command` bypasses the provider's built-in arg defaults (llm.py:51-55), so
# `args` must repeat what the "opencode" branch would have supplied.
command = "/Users/pedropombeiro/.local/share/mise/shims/opencode"
args = ["run", "--dangerously-skip-permissions"]

# Proactive context injection is enabled by the plugin's presence in
# opencode.json; this section only tunes it. thinking_gate_enabled trims the
# high-volume/low-value "thinking" channel, keeping an injection only when it is
# highly relevant or first in the session.
[proactive_context]
thinking_gate_enabled = true
