# NAS (QTS) configuration for opencode-memory (GHMEM).
#
# This host runs the *Rust* runtime (~/.local/bin/memory), not the Python one:
# lancedb/torch only ship manylinux_2_28 wheels and this NAS is glibc 2.21.
# See ~/.agents/docs/opencode-memory.md "NAS (QTS) Deployment".
#
# Kept deliberately separate from the work Mac's memory store -- this is an
# independent corpus, not a replica.

[identity]
instance = "gitlab.com"

[boot]
identity = true
active_sessions = true
hot_items = true
unresolved_blockers = true
recent_decisions = false
max_hot_items = 5

[ingestion]
# Only the NAS's own OpenCode session store. The Mac additionally watches a
# weekly-log brain directory; there is no equivalent here.
watch_paths = ["~/.local/share/opencode/opencode.db"]
db_poll_interval = 30
# LLM-based knowledge extraction runs `opencode run` per conversation (every 6h,
# up to 50 per cycle) and WILL incur API costs. Off deliberately.
llm_extraction = false

[storage]
path = "~/.local/share/opencode-memory"

# No [llm] section: the services are started by RunLast/cron with a minimal
# environment and there is no LLM provider wired up here. The worker logs
# "LLM: false" at startup, which is the intended state -- embeddings are local
# (candle) and need no provider.

# Auto-updates stay off: the binary is built from a commit pinned in
# /share/Container/scripts/build-opencode-memory.sh, so an in-place self-update
# would silently diverge from that pin (and could not rebuild itself anyway).
[update]
enabled = false

# Proactive context injection is enabled by the plugin's presence in
# opencode.json; this section only tunes it. thinking_gate_enabled trims the
# high-volume/low-value "thinking" channel.
[proactive_context]
thinking_gate_enabled = true
