{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "session.toggle.scrollbar": "ctrl+alt+t",
    "session.page.up": "pageup,ctrl+alt+b,home",
    "session.page.down": "pagedown,ctrl+alt+f,end",
    "session.first": "ctrl+g",
    "session.last": "ctrl+alt+g",
    "input.buffer.home": "none",
    "input.buffer.end": "none",
    "agent.cycle.reverse": "tab"
  },
  "scroll": {
    "speed": 3,
    "acceleration": true
  },
  "plugins": [
    "opencode-terminal-progress@1.0.2",
    "opencode-tmux-indicator@1.0.2"
  ]
}
