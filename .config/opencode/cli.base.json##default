{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "agent.cycle": "none",
    "session.toggle.scrollbar": "ctrl+alt+t",
    "agent.cycle.reverse": "tab"
  },
  "scroll": {
    "speed": 3,
    "acceleration": true
  },
  "plugins": [
    "./local-plugins/tui/permission-mode",  // Shift+Tab toggles the global permission preference
    "./local-plugins/tui/queue-command",    // Adds /queue to queue a message for later
    "opencode-terminal-progress@1.0.2",     // Shows agent progress in terminal tabs
    "opencode-tmux-indicator@1.0.2",        // Flags the tmux window while the agent waits for input
    "./local-plugins/tui/gitlab-mr-status", // Shows the session's PR/MR status in the prompt footer
    "./local-plugins/tui/session-metrics"   // Shows compaction, cache, and timing metrics
  ]
}
