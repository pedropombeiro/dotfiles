{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "agent.cycle": "none",
    "session.toggle.scrollbar": "ctrl+alt+t",
    "agent.cycle.reverse": "tab"
  },
  "scroll": {
    "speed": 3,
    "acceleration": true
  },
  "plugins": [
    "./local-plugins/tui/permission-mode",
    "./local-plugins/tui/queue-command",
    "opencode-terminal-progress@1.0.2",
    "opencode-tmux-indicator@1.0.2",
    "./local-plugins/tui/gitlab-mr-status",
    "./local-plugins/tui/session-metrics"
  ]
}
