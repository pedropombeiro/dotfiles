    { "action": "shell", "resource": "markdownlint *", "effect": "allow" },
    { "action": "shell", "resource": "markdownlint-cli2 *", "effect": "allow" },
    { "action": "shell", "resource": "md5 *", "effect": "allow" },
    { "action": "shell", "resource": "mirrord verify-config *", "effect": "allow" },
    { "action": "shell", "resource": "mise --version", "effect": "allow" },
    { "action": "shell", "resource": "mise *--help*", "effect": "allow" },
    { "action": "shell", "resource": "mise backends ls*", "effect": "allow" },
    { "action": "shell", "resource": "mise bin-paths*", "effect": "allow" },
