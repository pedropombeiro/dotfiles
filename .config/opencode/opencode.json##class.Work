      "git blame *": "allow",
      "git branch*": "allow",
      "git branch *": "allow",
      "git cat-file *": "allow",
      "git check-attr *": "allow",
      "git check-ignore *": "allow",
      "git commit*": "ask",
      "git commit *": "ask",
      "git config --get*": "allow",
      "git config --list*": "allow",
      "git describe*": "allow",
      "git diff*": "allow",
      "git fetch *": "allow",
      "git for-each-ref*": "allow",
      "git grep*": "allow",
      "git log*": "allow",
      "git ls-files*": "allow",
      "git ls-remote *": "allow",
      "git merge-base *": "allow",
      "git merge-tree *": "allow",
      "git name-rev *": "allow",
      "git push*": "ask",
      "git push *": "ask",
      "git reflog *": "allow",
      "git remote -v": "allow",
      "git rev-parse*": "allow",
      "git rev-list *": "allow",
      "git shortlog*": "allow",
      "git show*": "allow",
      "git show-ref*": "allow",
      "git stash list*": "allow",
      "git status*": "allow",
      "git worktree list*": "allow",
      "git --version": "allow",
      "gdk config get *": "allow",
      "gdk doctor*": "allow",
      "gdk psql*": "allow",
      "gdk status*": "allow",
      "gdk version*": "allow",
      ".opencode/skills/clickhouse/scripts/gdk-clickhouse *": "allow",
      ".opencode/skills/issue-state/scripts/start-issue.sh *": "allow",
      ".opencode/skills/issue-state/scripts/set-issue-status.sh *": "allow",
      ".opencode/skills/issue-state/scripts/sync-issue-state.sh *": "allow",
      "CLICKHOUSE_USER=* .opencode/skills/clickhouse/scripts/gdk-clickhouse *": "allow",
      "CLICKHOUSE_GDK_GITLAB_USER_PASSWORD=* .opencode/skills/clickhouse/scripts/gdk-clickhouse *": "allow",
      "CLICKHOUSE_USER=* CLICKHOUSE_GDK_GITLAB_USER_PASSWORD=* .opencode/skills/clickhouse/scripts/gdk-clickhouse *": "allow",
      "glab issue list *": "allow",
      "glab issue view *": "allow",
      "glab auth status*": "allow",
      "glab api *": "allow",
      "glab mr create *": "allow",
      "glab mr diff *": "allow",
      "glab mr list *": "allow",
      "glab mr note list *": "allow",
      "glab mr view *": "allow",
      "go build*": "allow",
      "go test*": "allow",
      "go vet*": "allow",
      "gh api *": "allow",
      "gh api *--field*": "ask",
      "gh api *--input*": "ask",
      "gh api *--method*": "ask",
      "gh api *--raw-field*": "ask",
      "gh api *-F *": "ask",
      "gh api *-X *": "ask",
      "gh api *-f *": "ask",
      "gh auth status*": "allow",
      "gh auth token*": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh release view *": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh run watch *": "allow",
      "gem contents *": "allow",
      "gem list*": "allow",
      "gem which *": "allow",
      "golangci-lint run*": "allow",
      "grep *": "allow",
      "head *": "allow",
      "hk check *": "allow",
      "hk run pre-commit *": "allow",
      "hostname": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "man *": "deny", // Context7 should be used instead
      "markdownlint *": "allow",
      "markdownlint-cli2 *": "allow",
      "md5 *": "allow",
      "mise ls *": "allow",
      "mise x clickhouse *": "allow",
      "mise fmt --check*": "allow",
      "mise ls-remote *": "allow",
      "mise registry *": "allow",
      "mise tasks": "allow",
      "mise tasks --list": "allow",
      "mise tasks --silent": "allow",
      "mise tasks info *": "allow",
      "mise tasks ls *": "allow",
      "mise which *": "allow",
      "mkdir -p /private/tmp/*": "allow",
      "mkdir -p /tmp/*": "allow",
      "npx markdownlint-cli2 *": "allow",
      "npx prettier *": "allow",
      "npx --yes --package renovate*": "allow",
      "node --check *": "allow",
      "opencode --version*": "allow",
      "opencode debug config*": "allow",
      "pgrep *": "allow",
      "pinchtab *": "allow",
      "pre-commit *": "allow",
      "printenv *": "allow",
      "printf *": "allow",
      "ps *": "allow",
      "pwd": "allow",
      "RAILS_ENV=test bundle exec rspec*": "allow",
      "RAILS_ENV=test bundle exec rubocop*": "allow",
      "readlink *": "allow",
      "redis-cli ping*": "allow",
      "rm -rf *": "deny",
      "run-in-tmux-pane bundle exec rspec*": "allow",
      "run-in-tmux-pane fgdku*": "allow",
      "run-in-tmux-pane gpsup*": "allow",
      "run-in-tmux-pane test_mr*": "allow",
      "rg *": "allow",
      "ruby -c *": "allow",
      "seq *": "allow",
      "sed *": "allow",
      "sha256 *": "allow",
      "shellcheck *": "allow",
      "sleep *": "allow",
      "sort*": "allow",
      "stat *": "allow",
      "strings *": "allow",
      "tail *": "allow",
      "test *": "allow",
      "tmux display-message *": "allow",
      "tmux list-windows *": "allow",
      "tmux show -s terminal-features": "allow",
      "tmux show-options *": "allow",
      "tr *": "allow",
      "true": "allow",
      "type *": "allow",
      "uniq *": "allow",
      "uv run ruff *": "allow",
      "uv run pytest *": "allow",
      "uv run vale *": "allow",
      "uv run markdownlint-cli2 *": "allow",
      "uv sync *": "allow",
      "vale *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "curl *": "allow",
      "curl *-d*": "ask",
      "curl *--data*": "ask",
      "curl *-F *": "ask",
      "curl *--form*": "ask",
      "curl *-T *": "ask",
      "curl *--upload-file*": "ask",
      "curl *--json*": "ask",
      "curl *-X*": "ask",
      "curl *--request*": "ask",
      "curl *-X GET*": "allow",
      "curl *-XGET*": "allow",
      "curl *--request GET*": "allow",
      "curl *--request=GET*": "allow",
      "wget *": "allow",
      "wget *--post-data*": "ask",
      "wget *--post-file*": "ask",
      "wget *--body-data*": "ask",
      "wget *--body-file*": "ask",
      "wget *--method*": "ask",
      "wget *--method GET*": "allow",
      "wget *--method=GET*": "allow",
      "xxd *": "allow",
      "yamllint *": "allow",
      "yadm blame *": "allow",
      "yadm check-ignore *": "allow",
      "yadm config --get*": "allow",
      "yadm diff*": "allow",
      "yadm grep*": "allow",
      "yadm log*": "allow",
      "yadm ls-files*": "allow",
      "yadm reflog *": "allow",
      "yadm remote -v": "allow",
      "yadm rev-parse*": "allow",
      "yadm show*": "allow",
      "yadm status*": "allow",
      "zsh -n *": "allow",
      "awk *": "allow",
      "base64 *": "allow",
      "bash -n *": "allow",
      "chmod +x /private/tmp/*": "allow",
      "chmod +x /tmp/*": "allow",
      // Broad API reads, narrowed below so explicit mutation flags still require approval.
      "glab api *--method*": "ask",
      "glab api *--form*": "ask",
      "glab api *--field*": "ask",
      "glab api *--raw-field*": "ask",
      "glab api *--input*": "ask",
      "glab api *-X *": "ask",
      "glab api *-f *": "ask",
      "glab api *-F *": "ask",
    },
    "external_directory": {
      "~/.agents/docs/*": "allow",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp/**/*": "allow",
      "/private/tmp/*": "allow",
      "/private/tmp": "allow"
    },
    // Denied: use Glean MCP instead (faster, more comprehensive, indexes more sources)
    "gitlab_documentation_search": "deny",
    "glob": "allow",
    "grep": "allow",
