    { "action": "shell", "resource": "CLICKHOUSE_GDK_GITLAB_USER_PASSWORD=* .opencode/skills/clickhouse/scripts/gdk-clickhouse *", "effect": "allow" },
    { "action": "shell", "resource": "CLICKHOUSE_USER=* CLICKHOUSE_GDK_GITLAB_USER_PASSWORD=* .opencode/skills/clickhouse/scripts/gdk-clickhouse *", "effect": "allow" },
    { "action": "shell", "resource": "scripts/lint-ai-principles-manifest.sh", "effect": "allow" },
    { "action": "shell", "resource": "scripts/lint-duo-review-instructions.sh", "effect": "allow" },
    { "action": "shell", "resource": "glab issue list *", "effect": "allow" },
    { "action": "shell", "resource": "glab issue view *", "effect": "allow" },
    { "action": "shell", "resource": "glab auth status*", "effect": "allow" },
    { "action": "shell", "resource": "glab api *", "effect": "allow" },
    { "action": "shell", "resource": "glab mr create *", "effect": "allow" },
    { "action": "shell", "resource": "glab mr diff *", "effect": "allow" },
    { "action": "shell", "resource": "glab mr list *", "effect": "allow" },
    { "action": "shell", "resource": "glab mr note list *", "effect": "allow" },
    { "action": "shell", "resource": "glab mr view *", "effect": "allow" },
    { "action": "shell", "resource": "glab skills get glab", "effect": "allow" },
    { "action": "shell", "resource": "go build*", "effect": "allow" },
