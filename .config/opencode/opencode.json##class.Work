{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "model": "gitlab/duo-chat-opus-5"
    },
    "build": {
      "model": "gitlab/duo-chat-gpt-5-6-terra"
    }
  },
  "default_agent": "plan",
  "plugin": [
    "opencode-gitlab-dap@1.19.4",
    "opencode-gitlab-plugin@2.7.0",
    "@mohak34/opencode-notifier@0.2.8",
    "opencode-atuin-history@0.2.0",
    "opencode-claude-prefill-fix@0.1.0",
    "opencode-forge-session-title@0.3.0",
    "opencode-homeassistant@0.7.8",
    "opencode-terminal-progress@0.5.1",
    "opencode-tmux-indicator@0.4.1",
    "opencode-wakatime@1.3.9",
    [
      "/Users/pedropombeiro/.local/share/opencode-memory-install/plugin",
      { "tools": false }
    ]
  ],
  "mcp": {
    "lazy-mcp": {
      "type": "local",
      "command": [
        "mise",
        "x",
        "npm:lazy-mcp",
        "--",
        "lazy-mcp",
        "--config",
        "~/.config/lazy-mcp/servers.json"
      ],
      "enabled": true
    }
  },
  "enabled_providers": ["ollama", "gitlab", "anthropic", "google"],
  "small_model": "gitlab/duo-chat-gpt-5-6-luna",
  "provider": {
    "anthropic": {
      "models": {
        "claude-fable-5": {
          "name": "Fable 5",
          "cost": {
            "input": 10, "output": 50, "cache_read": 1, "cache_write": 12.5
          }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4": {
          "name": "Gemma 4"
        },
        "gemma4:26b": {
          "name": "Gemma 4 26B MoE"
        },
        "gemma4:e2b": {
          "name": "Gemma 4:e2b"
        }
      }
    },
    "gitlab": {
      "models": {
        "duo-chat-fable-5": {
          "cost": {
            "input": 10, "output": 50, "cache_read": 1, "cache_write": 12.5
          }
        },
        "duo-chat-opus-5": {
          "cost": {
            "input": 5, "output": 25, "cache_read": 0.50, "cache_write": 6.25
          }
        },
        "duo-workflow-opus-5": {
          "cost": {
            "input": 5, "output": 25, "cache_read": 0.50, "cache_write": 6.25
          }
        },
        "duo-chat-opus-4-8": {
          "cost": {
            "input": 5, "output": 25, "cache_read": 0.50, "cache_write": 6.25
          }
        },
        "duo-workflow-opus-4-8": {
          "cost": {
            "input": 5, "output": 25, "cache_read": 0.50, "cache_write": 6.25
          }
        },
        "duo-workflow-opus-4-7": {
          "cost": {
            "input": 5, "output": 25, "cache_read": 0.50, "cache_write": 6.25
          }
        },
        "duo-chat-opus-4-7": {
          "cost": {
            "input": 5, "output": 25, "cache_read": 0.50, "cache_write": 6.25
          }
        },
        "duo-workflow-claude-fable-5": {
          "cost": {
            "input": 10, "output": 50, "cache_read": 1, "cache_write": 12.5
          }
        },
        "duo-workflow-opus-4-6": {
          "cost": {
            "input": 5, "output": 25, "cache_read": 0.50, "cache_write": 6.25
          }
        },
        "duo-chat-opus-4-6": {
          "cost": {
            "input": 5, "output": 25, "cache_read": 0.50, "cache_write": 6.25
          }
        },
        "duo-chat-opus-4-5": {
          "cost": {
            "input": 5, "output": 25, "cache_read": 0.50, "cache_write": 6.25
          }
        },
        "duo-chat-sonnet-5": {
          "cost": {
            "input": 3, "output": 15, "cache_read": 0.30, "cache_write": 3.75
          }
        },
        "duo-chat-sonnet-4-6": {
          "cost": {
            "input": 3, "output": 15, "cache_read": 0.30, "cache_write": 3.75
          }
        },
        "duo-chat-sonnet-4-5": {
          "cost": {
            "input": 3, "output": 15, "cache_read": 0.30, "cache_write": 3.75
          }
        },
        "duo-chat-sonnet-4": {
          "cost": {
            "input": 3, "output": 15, "cache_read": 0.30, "cache_write": 3.75
          }
        },
        "duo-chat-opus-4": {
          "cost": {
            "input": 15, "output": 75, "cache_read": 1.50, "cache_write": 18.75
          }
        },
        "duo-workflow-haiku-4-5": {
          "cost": { "input": 1, "output": 5, "cache_read": 0.10, "cache_write": 1.25 }
        },
        "duo-chat-haiku-4-5": {
          "cost": { "input": 1, "output": 5, "cache_read": 0.10, "cache_write": 1.25 }
        },
        "duo-chat-gpt-5-6-sol": {
          "cost": {
            "input": 5,
            "output": 30,
            "cache_read": 0.50,
            "cache_write": 6.25,
            "context_over_200k": {
              "input": 10, "output": 45, "cache_read": 1, "cache_write": 12.5
            }
          }
        },
        "duo-chat-gpt-5-6-terra": {
          "cost": {
            "input": 2,
            "output": 12,
            "cache_read": 0.20,
            "cache_write": 2.50,
            "context_over_200k": {
              "input": 4, "output": 18, "cache_read": 0.40, "cache_write": 5
            }
          }
        },
        "duo-chat-gpt-5-6-luna": {
          "cost": {
            "input": 0.20,
            "output": 1.20,
            "cache_read": 0.02,
            "cache_write": 0.25,
            "context_over_200k": {
              "input": 0.40, "output": 1.80, "cache_read": 0.04, "cache_write": 0.50
            }
          }
        }
      },
      "options": {
        "instanceUrl": "https://gitlab.com",
        "featureFlags": {
          "duo_agent_platform_agentic_chat": true,
          "duo_agent_platform": true
        }
      }
    }
  },
  "share": "disabled",
  "autoupdate": false,
  "server": {
    "hostname": "127.0.0.1",
    "mdns": false
  },
  "snapshot": false,
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "bundle exec rspec*": "allow",
      "bundle exec rubocop*": "allow",
      "bundle exec danger *": "allow",
      "bundle exec rake -T": "allow",
      "bundle exec bin/*": "allow",
      "bundle install*": "allow",
      "bundle list*": "allow",
      "bundle info *": "allow",
      "bundle show *": "allow",
      "bundle config get *": "allow",
      "cat *": "allow",
      "clickhouse client --port 9001 --query *": "allow",
      "column *": "allow",
      "cut *": "allow",
      "diff *": "allow",
      "docker container ls*": "allow",
      "docker image ls*": "allow",
      "docker images*": "allow",
      "docker info*": "allow",
      "docker inspect *": "allow",
      "docker network inspect *": "allow",
      "docker network ls *": "allow",
      "docker ps*": "allow",
      "docker stats*": "allow",
      "docker version*": "allow",
      "docker volume ls *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "env *": "allow",
      "file *": "allow",
      "find *": "allow",
      "date": "allow",
      "date *": "allow",
