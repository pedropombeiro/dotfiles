{
  "$schema": "https://opencode.ai/config.json",
  "skills": ["~/.agents/skills.work"],
  // Per-agent models take precedence over the top-level model, so `oc`'s inline
  // $OPENCODE_MODEL override (OPENCODE_CONFIG_CONTENT) does not apply to plan/build.
  "model": "gitlab/duo-chat-opus-5-5",
  "default_agent": "plan",
  "agents": {
    // The built-in title agent handles maintenance tasks such as session titles.
    "title": { "model": "gitlab/duo-chat-gpt-6-luna" },
    "plan": { "model": "gitlab/duo-chat-gpt-6-astra" },
    "build": { "model": "gitlab/duo-chat-opus-5-5" }
  },
  "plugins": [
    "opencode-gitlab-plugin@3.0.0",
    "@mohak34/opencode-notifier@0.5.0",
    "@nm156/opencode-wakatime@1.4.0",
    "opencode-atuin-history@1.0.1",
    "opencode-forge-session-title@1.2.0",
    "opencode-homeassistant@1.0.2",
    {
      // Sends metrics only to Alloy on the NAS. Traces carry prompts, code, and
      // tool output, and events carry commands and paths, so Work content stays
      // off personal infrastructure. See ~/.agents/docs/opencode.md#telemetry.
      // Temporary: a fork build that records locally executed tools. Revert to
      // "@devtheops/opencode-plugin-otel@2.0.0" once upstream releases the fix;
      // Renovate bumps that string when a release ships.
      "package": "github:pedropombeiro/opencode-plugin-otel#beaa8fca6876c861c5051a97c086aa53ac2b9902",
      "options": {
        "enabled": true,
        "endpoint": "https://otel.pombei.ro",
        "protocol": "http/protobuf",
        "logsEnabled": false,
        "disabledTraces": ["all"]
      }
    }
  ],
  "mcp": {
    "servers": {
      "lazy-mcp": {
        "type": "local",
        "command": [
          "mise",
          "x",
          "npm:lazy-mcp",
          "--",
          "lazy-mcp",
          "--config",
          "~/.config/lazy-mcp/servers.json"
        ]
      }
    }
  },
  // V1 field without a stable native equivalent; OpenCode turns it into provider policies.
  "enabled_providers": ["ollama", "gitlab", "anthropic", "google"],
  "providers": {
    "anthropic": {
      "models": {
        "claude-fable-5": {
          "name": "Fable 5",
          "cost": [{ "input": 10, "output": 50, "cache": { "read": 1, "write": 12.5 } }]
        }
      }
    },
    "ollama": {
      "name": "Ollama (local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4": {
          "name": "Gemma 4"
        },
        "gemma4:26b": {
          "name": "Gemma 4 26B MoE"
        },
        "gemma4:e2b": {
          "name": "Gemma 4:e2b"
        }
      }
    },
    "gitlab": {
      "package": "aisdk:gitlab-ai-provider@6.18.0",
      "settings": {
        "instanceUrl": "https://gitlab.com",
        "featureFlags": {
          "duo_agent_platform_agentic_chat": true,
          "duo_agent_platform": true
        }
      },
      "models": {
        // Superseded by Fable 5.1, Opus 5.5, and Sonnet 5.
        "duo-chat-opus-4-5": { "disabled": true },
        "duo-chat-opus-4-6": { "disabled": true },
        "duo-chat-opus-4-7": { "disabled": true },
        "duo-workflow-opus-4-5": { "disabled": true },
        "duo-workflow-opus-4-6": { "disabled": true },
        "duo-workflow-opus-4-7": { "disabled": true },
        "duo-chat-sonnet-4-5": { "disabled": true },
        "duo-chat-sonnet-4-6": { "disabled": true },
        "duo-workflow-sonnet-4-5": { "disabled": true },
        "duo-workflow-sonnet-4-6": { "disabled": true },
        "duo-chat-fable-5": {
          "disabled": true,
          "cost": [{ "input": 10, "output": 50, "cache": { "read": 1, "write": 12.5 } }]
        },
        "duo-chat-fable-5-1": {
          "cost": [{ "input": 10, "output": 50, "cache": { "read": 0.25, "write": 12.5 } }]
        },
        "duo-chat-opus-5": {
          "disabled": true,
          "cost": [{ "input": 5, "output": 25, "cache": { "read": 0.50, "write": 6.25 } }]
        },
        "duo-chat-opus-5-5": {
          "cost": [{ "input": 4, "output": 20, "cache": { "read": 0.20, "write": 5 } }]
        },
        "duo-workflow-opus-5": {
          "cost": [{ "input": 5, "output": 25, "cache": { "read": 0.50, "write": 6.25 } }]
        },
        "duo-workflow-opus-5-5": {
          "cost": [{ "input": 4, "output": 20, "cache": { "read": 0.20, "write": 5 } }]
        },
        "duo-chat-opus-4-8": {
          "disabled": true,
          "cost": [{ "input": 5, "output": 25, "cache": { "read": 0.50, "write": 6.25 } }]
        },
        "duo-workflow-opus-4-8": {
          "disabled": true,
          "cost": [{ "input": 5, "output": 25, "cache": { "read": 0.50, "write": 6.25 } }]
        },
        "duo-workflow-claude-fable-5": {
          "disabled": true,
          "cost": [{ "input": 10, "output": 50, "cache": { "read": 1, "write": 12.5 } }]
        },
        "duo-workflow-claude-fable-5-1": {
          "cost": [{ "input": 10, "output": 50, "cache": { "read": 0.25, "write": 12.5 } }]
        },
        "duo-chat-sonnet-5": {
          "cost": [{ "input": 2, "output": 10, "cache": { "read": 0.20, "write": 2.50 } }]
        },
        // Enable after gitlab-ai-provider ships the mappings in !49.
        "duo-chat-sonnet-5-5": {
          "disabled": true,
          "cost": [{ "input": 2, "output": 10, "cache": { "read": 0.20, "write": 2.50 } }]
        },
        "duo-chat-sonnet-4": {
          "disabled": true,
          "cost": [{ "input": 3, "output": 15, "cache": { "read": 0.30, "write": 3.75 } }]
        },
        "duo-chat-opus-4": {
          "disabled": true,
          "cost": [{ "input": 15, "output": 75, "cache": { "read": 1.50, "write": 18.75 } }]
        },
        "duo-workflow-haiku-4-5": {
          "cost": [{ "input": 1, "output": 5, "cache": { "read": 0.10, "write": 1.25 } }]
        },
        "duo-chat-haiku-4-5": {
          "cost": [{ "input": 1, "output": 5, "cache": { "read": 0.10, "write": 1.25 } }]
        },
        "duo-chat-gpt-6-astra": {
          "cost": [
            { "input": 10, "output": 50, "cache": { "read": 1, "write": 12.5 } },
            { "tier": { "type": "context", "size": 200000 }, "input": 20, "output": 75, "cache": { "read": 2, "write": 25 } }
          ]
        },
        "duo-chat-gpt-6-sol": {
          "cost": [
            { "input": 2, "output": 10, "cache": { "read": 0.20, "write": 2.50 } },
            { "tier": { "type": "context", "size": 200000 }, "input": 4, "output": 15, "cache": { "read": 0.40, "write": 5 } }
          ]
        },
        // Enable after gitlab-ai-provider ships the mappings in !49.
        "duo-chat-gpt-6-1-sol": {
          "disabled": true,
          "cost": [
            { "input": 2, "output": 10, "cache": { "read": 0.10, "write": 2.50 } },
            { "tier": { "type": "context", "size": 272000 }, "input": 4, "output": 15, "cache": { "read": 0.20, "write": 5 } }
          ]
        },
        "duo-chat-gpt-6-luna": {
          "cost": [
            { "input": 0.10, "output": 0.50, "cache": { "read": 0.01, "write": 0.125 } },
            { "tier": { "type": "context", "size": 200000 }, "input": 0.20, "output": 0.75, "cache": { "read": 0.02, "write": 0.25 } }
          ]
        },
        // Superseded by GPT 6 (Sol, Luna, Astra).
        "duo-chat-gpt-5-6-sol": {
          "disabled": true,
          "cost": [
            { "input": 5, "output": 30, "cache": { "read": 0.50, "write": 6.25 } },
            { "tier": { "type": "context", "size": 200000 }, "input": 10, "output": 45, "cache": { "read": 1, "write": 12.5 } }
          ]
        },
        "duo-chat-gpt-5-6-terra": {
          "disabled": true,
          "cost": [
            { "input": 2, "output": 12, "cache": { "read": 0.20, "write": 2.50 } },
            { "tier": { "type": "context", "size": 200000 }, "input": 4, "output": 18, "cache": { "read": 0.40, "write": 5 } }
          ]
        },
        "duo-chat-gpt-5-6-luna": {
          "disabled": true,
          "cost": [
            { "input": 0.20, "output": 1.20, "cache": { "read": 0.02, "write": 0.25 } },
            { "tier": { "type": "context", "size": 200000 }, "input": 0.40, "output": 1.80, "cache": { "read": 0.04, "write": 0.50 } }
          ]
        }
      }
    }
  },
  "share": "disabled",
  "update": "disable",
  "snapshots": false,
  // The last matching rule wins, so each broad default precedes its exceptions.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "~/.agents/docs/*", "effect": "allow" },
    { "action": "read", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/opencode/*", "effect": "ask" },
    { "action": "read", "resource": "~/.gnupg/*", "effect": "deny" },
    { "action": "read", "resource": "~/.netrc", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "brew bundle check *", "effect": "allow" },
    { "action": "shell", "resource": "brew info *", "effect": "allow" },
    { "action": "shell", "resource": "bundle exec rspec*", "effect": "allow" },
    { "action": "shell", "resource": "bundle exec rubocop*", "effect": "allow" },
    { "action": "shell", "resource": "bundle exec danger *", "effect": "allow" },
    { "action": "shell", "resource": "bundle exec rake -T", "effect": "allow" },
    { "action": "shell", "resource": "bundle exec bin/*", "effect": "allow" },
    { "action": "shell", "resource": "bundle install*", "effect": "allow" },
    { "action": "shell", "resource": "bundle list*", "effect": "allow" },
    { "action": "shell", "resource": "bundle info *", "effect": "allow" },
    { "action": "shell", "resource": "bundle show *", "effect": "allow" },
    { "action": "shell", "resource": "bundle config get *", "effect": "allow" },
    { "action": "shell", "resource": "caproni helmctl get *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "clickhouse client --port 9001 --query *", "effect": "allow" },
    { "action": "shell", "resource": "column *", "effect": "allow" },
    { "action": "shell", "resource": "comm *", "effect": "allow" },
    { "action": "shell", "resource": "cut *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "colima list *", "effect": "allow" },
    { "action": "shell", "resource": "colima status*", "effect": "allow" },
    { "action": "shell", "resource": "docker container ls*", "effect": "allow" },
    { "action": "shell", "resource": "docker context ls*", "effect": "allow" },
    { "action": "shell", "resource": "docker context show*", "effect": "allow" },
    { "action": "shell", "resource": "docker image ls*", "effect": "allow" },
    { "action": "shell", "resource": "docker images*", "effect": "allow" },
    { "action": "shell", "resource": "docker info*", "effect": "allow" },
    { "action": "shell", "resource": "docker inspect *", "effect": "allow" },
    { "action": "shell", "resource": "docker manifest inspect *", "effect": "allow" },
    { "action": "shell", "resource": "docker network inspect *", "effect": "allow" },
    { "action": "shell", "resource": "docker network ls *", "effect": "allow" },
    { "action": "shell", "resource": "docker ps*", "effect": "allow" },
    { "action": "shell", "resource": "docker stats*", "effect": "allow" },
    { "action": "shell", "resource": "docker version*", "effect": "allow" },
    { "action": "shell", "resource": "docker volume ls *", "effect": "allow" },
    { "action": "shell", "resource": "du *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "env *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "date*", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git branch*", "effect": "allow" },
    { "action": "shell", "resource": "git cat-file *", "effect": "allow" },
    { "action": "shell", "resource": "git check-attr *", "effect": "allow" },
    { "action": "shell", "resource": "git check-ignore *", "effect": "allow" },
    { "action": "shell", "resource": "git commit*", "effect": "ask" },
    { "action": "shell", "resource": "git config --get*", "effect": "allow" },
    { "action": "shell", "resource": "git config --list*", "effect": "allow" },
    { "action": "shell", "resource": "git describe*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git for-each-ref*", "effect": "allow" },
    { "action": "shell", "resource": "git grep*", "effect": "allow" },
    { "action": "shell", "resource": "git hash-object *", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files*", "effect": "allow" },
    { "action": "shell", "resource": "git ls-remote *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-tree*", "effect": "allow" },
    { "action": "shell", "resource": "git merge-base *", "effect": "allow" },
    { "action": "shell", "resource": "git merge-tree *", "effect": "allow" },
    { "action": "shell", "resource": "git name-rev *", "effect": "allow" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git range-diff *", "effect": "allow" },
    { "action": "shell", "resource": "git reflog *", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },
    { "action": "shell", "resource": "git remote get-url *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse*", "effect": "allow" },
    { "action": "shell", "resource": "git rev-list *", "effect": "allow" },
    { "action": "shell", "resource": "git shortlog*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "git show-ref*", "effect": "allow" },
    { "action": "shell", "resource": "git stash list*", "effect": "allow" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git worktree list*", "effect": "allow" },
