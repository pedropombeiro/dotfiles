    "servers": {
      "lazy-mcp": {
        "type": "local",
        "command": [
          "mise",
          "x",
          "npm:lazy-mcp",
          "--",
          "lazy-mcp",
          "--config",
          "~/.config/lazy-mcp/servers.json"
        ]
      }
    }
