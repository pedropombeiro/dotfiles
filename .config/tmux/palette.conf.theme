# Shared true-color palette and Powerline session/status layout.
set -g status-style 'bg=@THEME_background@,fg=@THEME_foreground@'
set -gw window-status-style 'bg=@THEME_background@,fg=@THEME_foreground@'
set -gw window-status-current-style 'bg=@THEME_background@,fg=@THEME_background@'
set -gw window-status-activity-style 'bg=@THEME_background@,fg=@THEME_foreground@'
set -g message-style 'bg=@THEME_surface@,fg=@THEME_text@'
set -g message-command-style 'bg=@THEME_border@,fg=@THEME_text@'
set -g display-panes-active-colour '@THEME_active@'
set -g display-panes-colour '@THEME_muted@'
set -gw clock-mode-colour '@THEME_active@'
set -g pane-border-style 'fg=@THEME_border@'
set -g pane-active-border-style 'fg=@THEME_active@'
set -g status-left '#[bg=@THEME_active@,fg=@THEME_background@,bold] #S #[bg=@THEME_background@,fg=@THEME_active@,nobold]'
set -g status-right '#[bg=@THEME_background@,fg=@THEME_surface@,nobold,noitalics,nounderscore]#[bg=@THEME_surface@,fg=@THEME_foreground@] %Y-%m-%d  %H:%M #[bg=@THEME_surface@,nobold,noitalics,nounderscore]#{?client_prefix,#[fg=#@THEME_waiting@],#{?pane_in_mode,#[fg=#@THEME_active@],#{?pane_synchronized,#[fg=#@THEME_select@],#[fg=#@THEME_border@]}}}#{tmux_mode_indicator}'
set -g @mode_indicator_prefix_mode_style 'bg=@THEME_waiting@,fg=@THEME_background@'
set -g @mode_indicator_copy_mode_style 'bg=@THEME_active@,fg=@THEME_background@'
set -g @mode_indicator_sync_mode_style 'bg=@THEME_select@,fg=@THEME_background@'
set -g @mode_indicator_empty_mode_style 'bg=@THEME_border@,fg=@THEME_text@'
set -g @fingers-hint-style 'fg=@THEME_waiting@,bold'
set -g @fingers-highlight-style 'fg=@THEME_hint@'
