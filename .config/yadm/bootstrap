#!/usr/bin/env bash

# Save this file as ~/.config/yadm/bootstrap and make it executable. It will
# execute all executable files (excluding templates and editor backups) in the
# ~/.config/yadm/bootstrap.d directory when run.

set -euo pipefail

# shellcheck source=./scripts/colors.sh
source "${HOME}/.config/yadm/scripts/colors.sh"
# shellcheck source=./scripts/iterm2.sh
source "${HOME}/.config/yadm/scripts/iterm2.sh"

# Directory to look for bootstrap executables in
BOOTSTRAP_D="${BASH_SOURCE[0]}.d"

if [[ ! -d "${BOOTSTRAP_D}" ]]; then
  echo "Error: bootstrap directory '${BOOTSTRAP_D}' not found" >&2
  exit 1
fi

# Scripts install Homebrew and mise tools, so re-read their paths before each
# script. mise shims give Bash scripts the tools that .zshenv adds for zsh.
_bootstrap_load_path() {
  local brew_bin
  for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [[ -x ${brew_bin} ]]; then
      eval "$("${brew_bin}" shellenv)"
      break
    fi
  done
  case ":${PATH}:" in
  *":${HOME}/.local/share/mise/shims:"*) ;;
  *) export PATH="${HOME}/.local/share/mise/shims:${PATH}" ;;
  esac
}

# Use stock macOS tools: fd is only installed by the scripts found here.
# Exclude alternate sources (##), editor backups (~$), and hidden files.
if ! _bootstrap_list=$(find -L "${BOOTSTRAP_D}" -mindepth 1 -maxdepth 1 \
  \( -type f -o -type l \) ! -name '*##*' ! -name '*~$*' ! -name '.*' | sort); then
  echo "Error: failed to list bootstrap scripts in '${BOOTSTRAP_D}'" >&2
  exit 1
fi
if [[ -z ${_bootstrap_list} ]]; then
  echo "Error: no bootstrap scripts found in '${BOOTSTRAP_D}' - run 'yadm alt' first" >&2
  exit 1
fi

declare -a bootstraps=()
while IFS= read -r bootstrap; do
  bootstraps+=("$bootstrap")
done <<<"${_bootstrap_list}"

# Plain assignments: ((n++)) returns 1 when n is 0, which exits under set -e.
_bootstrap_total=0
for bootstrap in "${bootstraps[@]}"; do
  if [[ -x "${bootstrap}" ]]; then
    _bootstrap_total=$((_bootstrap_total + 1))
  fi
done
_bootstrap_current=0

_cleanup_done=0
_bootstrap_cleanup() {
  # Read the status first: any command before this line would replace it.
  local rc=$?
  ((_cleanup_done)) && return
  _cleanup_done=1
  if [[ $rc -ne 0 ]]; then
    iterm2_progress -e
    iterm2_badge "bootstrap: FAILED"
  else
    iterm2_progress 100
    iterm2_badge -c
    iterm2_progress -c
  fi
  echo
}
trap _bootstrap_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

iterm2_badge "bootstrap: starting"
iterm2_progress -i

for bootstrap in "${bootstraps[@]}"; do
  if [[ -x "${bootstrap}" ]]; then
    _bootstrap_current=$((_bootstrap_current + 1))
    _bootstrap_load_path
    iterm2_progress "$((_bootstrap_current * 100 / _bootstrap_total))"
    iterm2_badge "bootstrap: $(basename "${bootstrap}")"
    printf "${YELLOW}%s${NC}\n" "Executing ${bootstrap} ..."
    if ! "${bootstrap}"; then
      echo "Error: bootstrap '${bootstrap}' failed" >&2
      exit 1
    fi
  fi
done
