#!/usr/bin/env bash

YADM_SCRIPTS=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../scripts" &>/dev/null && pwd)

# shellcheck source=../scripts/colors.sh
source "${YADM_SCRIPTS}/colors.sh"

# The Xcode Command Line Tools include git and make. /usr/bin/git exists as a
# launcher before they are installed, so check the developer directory instead.
if ! xcode-select -p >/dev/null 2>&1; then
  printf "${YELLOW}%s${NC}\n" "Installing the Xcode Command Line Tools - finish the installer dialog to continue"
  xcode-select --install || true
  until xcode-select -p >/dev/null 2>&1; do
    sleep 5
  done
fi

sudo softwareupdate -i -a
if [[ $(uname -m) == 'arm64' ]]; then
  sudo softwareupdate --install-rosetta --agree-to-license
fi

# install homebrew if it's missing
if ! command -v brew >/dev/null 2>&1; then
  printf "${YELLOW}%s${NC}\n" "Installing homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || exit 1
  for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [[ -x ${brew_bin} ]] && eval "$("${brew_bin}" shellenv)" && break
  done
  command -v brew >/dev/null 2>&1 || {
    printf "${RED}%s${NC}\n" "Homebrew installed, but brew is not on PATH"
    exit 1
  }
fi

if [ -f "${HOME}/.Brewfile" ]; then
  printf "${YELLOW}%s${NC}\n" "Updating homebrew bundle"
  brew bundle --global || printf "${RED}%s${NC}\n" "Failed to install packages"
fi

# 001 runs before Homebrew installs pam-reattach, so add it to sudo_local now.
# Without it, Touch ID for sudo doesn't work inside tmux.
if [[ -f /opt/homebrew/lib/pam/pam_reattach.so ]] &&
  ! grep -q pam_reattach /etc/pam.d/sudo_local 2>/dev/null; then
  "${YADM_SCRIPTS}/enable-touchid-on-terminal.sh"
fi

printf "${YELLOW}%s${NC}\n" "Installing Mac App Store apps"
mise bootstrap --only packages --yes || printf "${RED}%s${NC}\n" "Failed to install Mac App Store apps"

if [[ ! -f ${HOME}/.fzf.zsh ]]; then
  printf "${YELLOW}%s${NC}\n" "Installing FZF scripts"
  "$(brew --prefix fzf)"/install --no-update-rc --completion --key-bindings
fi
