#!/usr/bin/env bash

set -euo pipefail

class="$(yadm config --get local.class)"
backup="${HOME}/Sync/pedro/Briefcase/Backups/MBP.${class}/Input Source Pro Settings.json"

if [[ ! -f "${backup}" ]]; then
  echo "Skipping Input Source Pro import: backup not found at ${backup}"
  exit 0
fi

# The marker holds the hash of the last backup confirmed as imported, so a
# re-run doesn't overwrite settings changed since then. The import URL gives no
# result, so only a confirmation at the prompt records it. Set
# INPUT_SOURCE_PRO_FORCE_IMPORT=1 to import an unchanged backup again.
marker="${XDG_STATE_HOME:-${HOME}/.local/state}/yadm/input-source-pro-imported.sha256"
backup_hash="$(shasum -a 256 "${backup}" | cut -d' ' -f1)"
if [[ ${INPUT_SOURCE_PRO_FORCE_IMPORT:-} != 1 && -f "${marker}" && "$(<"${marker}")" == "${backup_hash}" ]]; then
  echo "Skipping Input Source Pro import: this backup was already imported (set INPUT_SOURCE_PRO_FORCE_IMPORT=1 to import it again)"
  exit 0
fi

if ! osascript -e 'id of app "Input Source Pro"' &>/dev/null; then
  echo "Skipping Input Source Pro import: app not found"
  exit 0
fi

echo "Ensuring Input Source Pro URL handler is registered..."
open -a "Input Source Pro"
sleep 3

echo "Importing Input Source Pro settings from ${backup}"
open "inputsourcepro://import?path=${backup}"

if [[ ! -t 0 ]]; then
  echo "No terminal to confirm the Input Source Pro import; it will be offered again on the next run"
  exit 0
fi

read -r -p "Did Input Source Pro import the settings? [y/N] " answer
if [[ ${answer} == [yY]* ]]; then
  mkdir -p "${marker%/*}"
  printf '%s\n' "${backup_hash}" >"${marker}"
else
  echo "Not recording the import; it will be offered again on the next run"
fi
