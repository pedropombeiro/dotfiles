#!/usr/bin/env bash

set -euo pipefail

curl -fsSL "https://gitlab.com/gitlab-org/gitlab-development-kit/-/raw/main/support/install" | bash
if [[ -d ~/gitlab-development-kit ]]; then
  touch ~/gitlab-development-kit/.metadata_never_index
elif [[ -d ~/gdk ]]; then
  touch ~/gdk/.metadata_never_index
fi
