#!/usr/bin/env bash
#
# Adds the template `upstream` remote to the weekly-log checkout. mise clones the
# repo from `[bootstrap.repos]` in conf.d/bootstrap.work.toml, but it cannot
# declare extra remotes. config.toml##class.Work watches for second-brain files
# (ingestion.watch_paths -> .../weekly-log/brain). Idempotent: safe to re-run,
# never touches an existing worktree's branch or history.

YADM_SCRIPTS=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../scripts" &>/dev/null && pwd)

# shellcheck source=../scripts/colors.sh
source "${YADM_SCRIPTS}/colors.sh"

REPO_DIR="${HOME}/Developer/gitlab.com/pedropombeiro/weekly-log"
UPSTREAM_URL="ssh://git@gitlab.com/gitlab-org/growth/ai/weekly-log-template.git"

if [[ ! -d "${REPO_DIR}/.git" ]]; then
  printf "${RED}%s${NC}\n" "${REPO_DIR} is not a git repo - run 'mise bootstrap repos apply' first (SSH agent locked? no network?)"
  exit 0
fi

current_upstream="$(git -C "${REPO_DIR}" remote get-url upstream 2>/dev/null || true)"

if [[ -z "${current_upstream}" ]]; then
  git -C "${REPO_DIR}" remote add upstream "${UPSTREAM_URL}"
  printf "${GREEN}%s${NC}\n" "Added missing 'upstream' remote to weekly-log repo"
elif [[ "${current_upstream}" != "${UPSTREAM_URL}" ]]; then
  printf "${YELLOW}%s${NC}\n" "'upstream' remote is '${current_upstream}', expected '${UPSTREAM_URL}' - leaving as-is"
fi

if ! compgen -G "${REPO_DIR}/brain/[0-9][0-9][0-9][0-9]" >/dev/null; then
  printf "${YELLOW}%s${NC}\n" "No brain/<YYYY>/ directory found - second-brain watcher has nothing to ingest yet"
fi
