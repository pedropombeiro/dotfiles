#!/usr/bin/env bash

set -euo pipefail

YADM_SCRIPTS=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../scripts" &>/dev/null && pwd)

# shellcheck source=../scripts/colors.sh
source "${YADM_SCRIPTS}/colors.sh"

credentials_dir="${HOME}/.config/lazy-mcp"
op_account_id="LKATQYUATRBRDHRRABEBH4RJ5Y" # gitlab.1password.com
op_vault_id="6gq44ckmq23vqk5poqunurdgay"   # Engineering
op_item_title="ClickHouse Cloud - ppombeiro_local_user"

mkdir -p "${credentials_dir}"
umask 077

# Caches one field of the 1Password item in a file that the clickhouse server
# in lazy-mcp/servers.json reads through {file:...}.
setup_field() {
  local field=$1
  local target="${credentials_dir}/clickhouse-${field}"
  local tmp_file

  if [[ -s "${target}" ]]; then
    chmod 600 "${target}"
    printf "${GREEN}%s${NC}\n" "ClickHouse MCP ${field} file already exists"
    return 0
  fi

  tmp_file=$(mktemp "${target}.XXXXXX")

  if command -v op >/dev/null 2>&1; then
    if op read --no-newline --account "${op_account_id}" \
      "op://${op_vault_id}/${op_item_title}/${field}" >"${tmp_file}" &&
      [[ -s "${tmp_file}" ]]; then
      mv "${tmp_file}" "${target}"
      chmod 600 "${target}"
      printf "${GREEN}%s${NC}\n" "Configured ClickHouse MCP ${field} from 1Password"
      return 0
    fi

    printf "${YELLOW}%s${NC}\n" "Could not read the ClickHouse MCP ${field} from the configured 1Password account and vault"
  else
    printf "${YELLOW}%s${NC}\n" "1Password CLI is unavailable; cannot configure the ClickHouse MCP ${field}"
  fi
  rm -f "${tmp_file}"

  # A placeholder keeps lazy-mcp available when 1Password is unavailable. The
  # clickhouse server fails to authenticate until this file is filled in.
  : >"${target}"
  chmod 600 "${target}"
  printf "${YELLOW}%s${NC}\n" "Created an empty ${target}. Copy the ${field} of the '${op_item_title}' item in the Engineering 1Password vault into it"
}

setup_field username
setup_field password
