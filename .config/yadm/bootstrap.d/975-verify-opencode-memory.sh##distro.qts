#!/usr/bin/env bash
#
# Verify the opencode-memory (GHMEM) Rust runtime is installed on this NAS.
#
# Deliberately does NOT build: a cold release build is ~105 minutes, which has
# no place in `yadm bootstrap`. This only reports status and points at the
# build script, and never fails the bootstrap run.
#
# See ~/.agents/docs/opencode-memory.md ("NAS (QTS) Deployment") for why this
# host uses the Rust runtime and builds it from source.

YADM_SCRIPTS=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../scripts" &>/dev/null && pwd)

# shellcheck source=../scripts/colors.sh
source "${YADM_SCRIPTS}/colors.sh"

MEMORY_BIN="${HOME}/.local/bin/memory"
BUILD_SCRIPT="/share/Container/scripts/build-opencode-memory.sh"

if [[ -x ${MEMORY_BIN} ]]; then
  printf "${GREEN}%s${NC}\n" "opencode-memory installed: $("${MEMORY_BIN}" --version 2>/dev/null)"
  exit 0
fi

printf "${YELLOW}%s${NC}\n" "opencode-memory (GHMEM) is not installed on this NAS."
printf "%s\n" "  Build it with: ${BUILD_SCRIPT}"
printf "%s\n" "  Note: a cold build takes roughly 105 minutes."

exit 0
