#!/usr/bin/env zsh

set -o pipefail
setopt EXTENDED_GLOB
source "${${(%):-%x}:A:h:h}/lib/check-helpers.zsh"

check_app_running() {
  local app_name=${1}
  local bundle_id=${2}

  print_op_stay "Checking if ${app_name} is running"
  if pgrep "${app_name}" >/dev/null; then
    print_ok
    return
  fi

  local launch_error
  if [[ -n "${bundle_id}" ]]; then
    launch_error=$(open -b "${bundle_id}" 2>&1)
  else
    launch_error=$(open -a "${app_name}" 2>&1)
  fi
  if (( $? != 0 )); then
    print_failure "Failed to launch ${app_name}: ${launch_error}"
    any_failed=1
    return
  fi

  sleep 1
  if pgrep "${app_name}" >/dev/null; then
    print_failure "${app_name} is not running (fixed)"
  else
    print_failure "${app_name} is not running"
    any_failed=1
  fi
}

check_hammerspoon_bluetooth() {
  print_op_stay "Checking Hammerspoon Bluetooth permission"
  # The permission lives in the user TCC database, which this shell cannot read.
  # Run blueutil from inside Hammerspoon so macOS applies Hammerspoon's grant.
  local blueutil_bin
  blueutil_bin=$(command -v blueutil 2>/dev/null || echo /opt/homebrew/bin/blueutil)

  if ! command -v hs >/dev/null 2>&1 || ! pgrep -x Hammerspoon >/dev/null 2>&1; then
    echo
    print_warn "Hammerspoon is not running; cannot verify Bluetooth permission"
    return
  fi

  local power
  power=$(hs -t 10 -c "local out, ok, _, rc = hs.execute('${blueutil_bin} --power'); print(ok and rc == 0 and (out:gsub('%s+', '')) or 'error')" 2>/dev/null | tail -1)

  case "$power" in
    1)
      print_ok
      ;;
    0)
      echo
      print_warn "Bluetooth is off; cannot verify Hammerspoon's permission"
      ;;
    *)
      echo
      print_failure "Hammerspoon cannot use Bluetooth (System Settings > Privacy & Security > Bluetooth)"
      any_failed=1
      ;;
  esac
}

check_app_running 'Hammerspoon'
check_hammerspoon_bluetooth
check_app_running 'Stream Deck' 'com.elgato.StreamDeck'
check_app_running 'Home Assistant'
exit "$any_failed"
