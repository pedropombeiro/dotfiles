#!/usr/bin/env zsh

set -o pipefail

YADM_SCRIPTS=$( cd -- "$( dirname -- ${(%):-%x} )/../scripts" &> /dev/null && pwd )

source "${YADM_SCRIPTS}/run-checks-common.zsh"

check_app_running() {
  local app_name=${1}
  local bundle_id=${2}

  print_op_stay "Checking if ${app_name} is running"
  if pgrep "${app_name}" >/dev/null; then
    print_ok
    return
  fi

  local launch_error
  if [[ -n "${bundle_id}" ]]; then
    launch_error=$(open -b "${bundle_id}" 2>&1)
  else
    launch_error=$(open -a "${app_name}" 2>&1)
  fi
  if (( $? != 0 )); then
    print_failure "Failed to launch ${app_name}: ${launch_error}"
    any_failed=1
    return
  fi

  sleep 1
  if pgrep "${app_name}" >/dev/null; then
    print_failure "${app_name} is not running (fixed)"
  else
    print_failure "${app_name} is not running"
    any_failed=1
  fi
}

check_stream_deck_usb() {
  print_op_stay "Checking Stream Deck USB port location"
  local hub port
  eval "$(hs -c 'local c = require("constants"); return "hub=" .. c.usbHub .. " port=" .. c.streamDeckPort')"
  local i=0
  while (( i < 20 )); do
    if uhubctl --location "$hub" --port "$port" 2>/dev/null | grep "Elgato Stream Deck XL" >/dev/null; then
      print_ok
      return
    fi
    sleep 0.5
    i=$((i + 1))
  done
  print_failure "Stream Deck not found at uhubctl location $hub port $port"
  any_failed=1
}

port_power_status() {
  local hub=$1 port=$2
  local output line
  if [[ -z "$hub" || -z "$port" ]]; then
    print -r -- "USB hub configuration is unavailable"
    return 1
  fi
  if ! output=$(uhubctl --location "$hub" --port "$port" 2>&1); then
    print -r -- "Cannot inspect hub ${hub} port ${port}: ${output}"
    return 1
  fi
  for line in ${(f)output}; do
    if [[ "$line" == *"Port ${port}: "* ]]; then
      print -r -- "$line"
      return 0
    fi
  done
  print -r -- "No status returned for hub ${hub} port ${port}; check the dock connection and configured location"
  return 1
}

check_usb_port_powered() {
  local label=$1 hub=$2 port=$3

  print_op_stay "Checking ${label} USB port power"
  local port_status
  if ! port_status=$(port_power_status "$hub" "$port"); then
    echo
    print_failure "${label}: ${port_status}"
    any_failed=1
    return
  fi

  if [[ " $port_status " == *" power "* ]]; then
    print_ok
    return
  fi

  echo
  if [[ " $port_status " != *" off "* ]]; then
    print_failure "${label}: unrecognized power state: ${port_status}"
    any_failed=1
    return
  fi
  local output
  if ! output=$(uhubctl --action on --location "$hub" --port "$port" 2>&1); then
    print_failure "${label}: failed to power on hub ${hub} port ${port}: ${output}"
    any_failed=1
    return
  fi
  sleep 2
  if ! port_status=$(port_power_status "$hub" "$port"); then
    print_failure "${label}: power-on verification failed: ${port_status}"
    any_failed=1
  elif [[ " $port_status " != *" power "* ]]; then
    print_failure "${label}: power-on verification failed: ${port_status}"
    any_failed=1
  else
    print_ok "${label}: restored power to hub ${hub} port ${port}"
  fi
}

busylight_usb_present() {
  local inventory
  inventory=$(ioreg -p IOUSB -w0 -l 2>/dev/null) || return 2
  print -r -- "$inventory" | grep -i '"USB Product Name" = "BUSYLIGHT"' >/dev/null
}

# NO_DEVICE only says BusylightHTTP has no light to talk to. Walk the chain from
# the USB bus outwards so the check names the link that is actually broken.
busylight_no_device_reason() {
  local hub=$shared_hub port=$shared_port usb_rc
  if busylight_usb_present; then
    printf '%s\n' "device is visible on USB, but BusylightHTTP reports NO_DEVICE - try restarting BusylightHTTP"
    return
  else
    usb_rc=$?
  fi
  if (( usb_rc != 1 )); then
    print -r -- "USB inspection failed; device presence is unknown"
    return
  fi

  if ! command -v uhubctl >/dev/null 2>&1; then
    printf '%s\n' "device is not on the USB bus (uhubctl unavailable, cannot inspect hub power)"
    return
  fi

  if [[ -z "$hub" || -z "$port" ]]; then
    printf '%s\n' "device is not on the USB bus (could not read the hub location from Hammerspoon constants)"
    return
  fi

  local port_status
  if ! port_status=$(port_power_status "$hub" "$port"); then
    printf '%s\n' "device is not visible on USB; ${port_status}"
  elif [[ " $port_status " == *" off "* ]]; then
    printf '%s\n' "hub ${hub} port ${port} is powered off - run: uhubctl --action on --location ${hub} --port ${port}"
  elif [[ " $port_status " != *" power "* ]]; then
    printf '%s\n' "device is not visible on USB; unrecognized port state: ${port_status}"
  elif [[ " $port_status " != *" connect "* ]]; then
    printf '%s\n' "hub ${hub} port ${port} is powered but empty - check the cable from the dock to the Busylight hub"
  else
    printf '%s\n' "hub ${hub} port ${port} has a device, but no BUSYLIGHT on the bus - check the light's own cable"
  fi
}

probe_busylight_endpoint() {
  local url=$1
  local body http_code
  body=$(curl --silent --max-time 0.5 --write-out '\n%{http_code}' "$url" 2>/dev/null)
  local rc=$?
  http_code=${body##*$'\n'}
  body=${body%$'\n'*}
  printf '%s\n%s\n%s\n' "$rc" "$http_code" "$body"
}

check_busylight_local() {
  print_op_stay "Checking Busylight HTTP server (direct)"
  local url="http://localhost:8989?action=currentpresence"
  local result rc http_code body
  result=$(probe_busylight_endpoint "$url")
  rc=${${(f)result}[1]}
  http_code=${${(f)result}[2]}
  body=${${(f)result}[3]}

  if [[ $rc -eq 0 && $http_code == 200 ]]; then
    print_ok "$(echo "$body" | jq -r '.runningcommand.parameter')"
    return
  fi

  if [[ $rc -eq 0 && $http_code == 404 ]] && echo "$body" | grep -q NO_DEVICE; then
    echo
    print_warn "Busylight unavailable: $(busylight_no_device_reason)"
    return
  fi

  echo
  if pgrep BusylightHTTP >/dev/null; then
    print_failure "Busylight HTTP server is running, but API endpoint can't be reached"
    any_failed=1
    return
  fi

  print_failure "Busylight HTTP server is not running, attempting restart..."
  open -a BusylightHTTP
  local i=0
  while (( i < 10 )); do
    sleep 0.5
    result=$(probe_busylight_endpoint "$url")
    rc=${${(f)result}[1]}
    http_code=${${(f)result}[2]}
    body=${${(f)result}[3]}
    if [[ $rc -eq 0 && ($http_code == 200 || $http_code == 404) ]]; then
      if [[ $http_code == 404 ]] && echo "$body" | grep -q NO_DEVICE; then
        print_warn "Busylight HTTP server restarted, but unavailable: $(busylight_no_device_reason)"
      else
        print_ok "(restarted)"
      fi
      return
    fi
    i=$((i + 1))
  done

  print_failure "Busylight HTTP server failed to start"
  any_failed=1
}

check_nginx() {
  print_op_stay "Checking nginx"
  if pgrep nginx >/dev/null; then
    print_ok
    return
  fi

  echo
  brew services restart nginx
  sleep 2
  if pgrep nginx >/dev/null; then
    print_failure "nginx is not running (fixed)"
  else
    print_failure "nginx is not running"
    any_failed=1
  fi
}

check_busylight_proxy() {
  print_op_stay "Checking Busylight HTTP server (via nginx)"
  local url="http://gitlab-macbookpro:18989?action=currentpresence"
  local result rc http_code body
  result=$(probe_busylight_endpoint "$url")
  rc=${${(f)result}[1]}
  http_code=${${(f)result}[2]}
  body=${${(f)result}[3]}

  if [[ $rc -eq 0 && $http_code == 200 ]]; then
    print_ok "$(echo "$body" | jq -r '.runningcommand.parameter')"
    return
  fi

  if [[ $rc -eq 0 && $http_code == 404 ]] && echo "$body" | grep -q NO_DEVICE; then
    # Proxy reaches the same daemon, so the direct check already explained why.
    print_warn "Busylight device not connected (proxy itself is healthy)"
    return
  fi

  echo
  print_failure "Busylight HTTP server is not reachable through nginx proxy"
  any_failed=1
}

check_gdk_wakatime_projects() {
  [[ -n "$GDK_ROOT" ]] || return 0

  local wakatime_dirs=("$GDK_ROOT")
  for subdir in "$GDK_ROOT"/*/; do
    local d="${subdir%/}"
    [[ "$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" == "$d" ]] && wakatime_dirs+=("$d")
  done

  local _line
  for wd in "${wakatime_dirs[@]}"; do
    local wp_file="$wd/.wakatime-project"
    local label="${wd#$GDK_ROOT/}"
    [[ "$wd" == "$GDK_ROOT" ]] && label="(root)"

    print_op_stay "Checking .wakatime-project in GDK $label"
    if ! git -C "$wd" remote get-url origin &>/dev/null; then
      print_ok "(no remote, skipped)"
    elif [[ -f "$wp_file" ]] && { read -r _line < "$wp_file" && [[ -n "$_line" ]]; }; then
      print_ok "$_line"
    else
      print_failure ".wakatime-project missing or empty in $wd"
      any_failed=1
    fi
  done
}

check_glab_auth() {
  print_op_stay "Checking glab authentication"
  if ! command -v glab >/dev/null 2>&1; then
    echo
    print_failure "glab is not installed"
    any_failed=1
    return
  fi

  if glab auth status >/dev/null 2>&1; then
    print_ok
  else
    echo
    print_failure "glab is not authenticated (run: glab auth login)"
    any_failed=1
  fi
}

check_hammerspoon_bluetooth() {
  print_op_stay "Checking Hammerspoon Bluetooth permission"
  local hs_bundle_id="org.hammerspoon.Hammerspoon"
  if defaults read /Library/Preferences/com.apple.Bluetooth.plist 2>/dev/null | grep -q "$hs_bundle_id"; then
    print_ok
    return
  fi

  local tcc_db="$HOME/Library/Application Support/com.apple.TCC/TCC.db"
  if [[ -r "$tcc_db" ]] && sqlite3 "$tcc_db" "SELECT client FROM access WHERE service='kTCCServiceBluetoothAlways' AND client='$hs_bundle_id' AND auth_value=2;" 2>/dev/null | grep -q "$hs_bundle_id"; then
    print_ok
    return
  fi

  echo
  print_failure "Hammerspoon lacks Bluetooth permission (System Settings > Privacy & Security > Bluetooth)"
  any_failed=1
}

check_weekly_log_repo() {
  setopt LOCAL_OPTIONS EXTENDED_GLOB
  print_op_stay "Checking weekly-log repo"

  local repo_dir="$HOME/Developer/gitlab.com/pedropombeiro/weekly-log"
  if [[ ! -d "$repo_dir/.git" ]]; then
    echo
    print_failure "weekly-log repo not found at $repo_dir"
    any_failed=1
    return
  fi

  # brain/ itself exists on every branch (scaffolding only: .gitkeep +
  # README.md); a populated brain/<YYYY>/ is the real signal that content is
  # checked out and the weekly log contains real content.
  local -a year_dirs
  year_dirs=("$repo_dir"/brain/[0-9](#c4)(N/))
  if (( ${#year_dirs} == 0 )); then
    echo
    print_failure "$repo_dir/brain has no year directories - checked out an empty branch?"
    any_failed=1
    return
  fi

  print_ok
}

# lefthook-local.yml only supplies `env:` overlays for commands defined in
# lefthook.yml. When upstream renames or drops a command, the orphaned override
# has no `run:`, and lefthook aborts the whole hook — blocking every push with
# an error buried under the passing checks.
check_lefthook_local_overrides() {
  print_op_stay "Checking lefthook-local.yml overrides"

  local repo="$GDK_ROOT/gitlab"
  local local_cfg="$repo/lefthook-local.yml"
  local base_cfg="$repo/lefthook.yml"

  if [[ ! -f "$local_cfg" || ! -f "$base_cfg" ]]; then
    print_ok "(skipped, no lefthook config)"
    return
  fi

  local -a orphans
  local cmd
  # Command names are the 4-space-indented keys under each hook's `commands:`.
  for cmd in ${(f)"$(grep -oE '^ {4}[A-Za-z0-9_-]+:' "$local_cfg" | tr -d ' :')"}; do
    grep -qE "^ +${cmd}:" "$base_cfg" || orphans+=("$cmd")
  done

  if (( ${#orphans} == 0 )); then
    print_ok
  else
    echo
    for cmd in "${orphans[@]}"; do
      print_warn "lefthook-local.yml overrides '${cmd}', absent from lefthook.yml — pushes will abort"
    done
  fi
}

check_app_running 'Hammerspoon'
check_hammerspoon_bluetooth
check_app_running 'Stream Deck' 'com.elgato.StreamDeck'

shared_hub=""
shared_port=""
if uhubctl >/dev/null 2>&1; then
  check_stream_deck_usb

  if shared_config=$(hs -c 'local c = require("constants"); return c.usbHub .. " " .. c.sharedPeripheralPort' 2>&1) &&
      shared_config=$(print -r -- "$shared_config" | jq -Rer 'capture("^(?<hub>[0-9]+([.-][0-9]+)*) (?<port>[0-9]+)$") | .hub, .port' 2>&1) && [[ -n "$shared_config" ]]; then
    shared_hub=${${(f)shared_config}[1]}
    shared_port=${${(f)shared_config}[2]}
    check_usb_port_powered 'Busylight hub' "$shared_hub" "$shared_port"
  else
    print_failure "Cannot read Busylight hub configuration from Hammerspoon: ${shared_config}"
    any_failed=1
  fi

fi

# The HTTP checks can diagnose service failures even when USB inspection fails.
check_nginx
check_busylight_local
check_busylight_proxy

check_app_running 'Home Assistant'
check_glab_auth
check_gdk_wakatime_projects
check_weekly_log_repo
check_lefthook_local_overrides

if (( any_failed )); then
  printf "${YELLOW}%s${NC}\n" "⚠️  Checks finished with errors/warnings!"
  exit 1
else
  printf "${GREEN}%s${NC}\n" "✅ Checks finished!"
fi
