#!/usr/bin/env zsh

YADM_SCRIPTS=$( cd -- "$( dirname -- ${(%):-%x} )/../scripts" &> /dev/null && pwd )

source "${YADM_SCRIPTS}/update-ui.zsh"

_is_work=0
[[ $(yadm config local.class) == 'Work' ]] && _is_work=1

_step_files=(${(%):-%x} "${YADM_SCRIPTS}/update-common.zsh")
(( _is_work )) && _step_files+=("${YADM_SCRIPTS}/update-work.zsh")
_update_init "${_step_files[@]}"
_update_require_sudo
_update_track brew cask mise npm mas

step_relink() {
  "${YADM_SCRIPTS}/relink-dotfiles.zsh"
}

step_brew() {
  local brew_prefix brew_cellar root_owned_output
  local -a python_roots root_owned
  local -i cleanup_rc=0

  # Root-run Python tools can leave bytecode caches that block `brew cleanup`.
  # Limit repairs to Python caches and preserve groups and non-root ownership.
  brew_prefix=$(brew --prefix)
  brew_cellar=$(brew --cellar)
  python_roots=(
    "$brew_cellar"/python(N/)
    "$brew_cellar"/python@*(N/)
    "$brew_prefix"/lib/python*/site-packages(N/)
  )
  if (( ${#python_roots[@]} )); then
    root_owned_output=$(find "${python_roots[@]}" -xdev -user 0 \
      \( -type d -o -type f \) \
      \( -path '*/__pycache__' -o -path '*/__pycache__/*' \) -print0)
    root_owned=("${(@0)root_owned_output}")
    # Quoted NUL splitting preserves the empty entry after find's final delimiter.
    root_owned=("${(@)root_owned:#}")
  fi
  if (( ${#root_owned[@]} )); then
    printf '%s\n' "${root_owned[@]}"
    sudo chown -h "$UID" "${root_owned[@]}"
    _update_note "fixed ownership of ${#root_owned[@]} root-owned Python cache entries"
  fi

  brew update
  brew upgrade --yes
  brew bundle --global --quiet
  brew bundle cleanup --global --force || cleanup_rc=$?
  # `brew bundle cleanup` hides `brew cleanup` stderr; rerun it so failures are visible.
  brew cleanup
  return ${cleanup_rc}
}

step_tmux_signature() {
  "${YADM_SCRIPTS}/sign-tmux.zsh"
}

# Converge the declarative resources in conf.d/bootstrap*.toml. Keep the scope
# explicit: dotfiles, macOS defaults, and user sections overlap YADM workflows.
# The tools phase is covered by the mise step below.
step_mise_bootstrap() {
  mise bootstrap --only packages,repos,macos-launchd-agents --skip-dirty --yes
}

step_mas() {
  mise run mas:upgrade
}

step_mise() {
  (cd ~ && mise plugins update && mise install --yes && mise upgrade --yes)
  "${YADM_SCRIPTS}/mise-prune-if-needed.zsh"
}

step_brew_dump() {
  mise run brew:dump
}

_step "relink dotfiles" step_relink
_step "brew" step_brew
_step "tmux signature" step_tmux_signature
_step "mise bootstrap" step_mise_bootstrap
_step "mac app store" step_mas
_step "mise tools" step_mise

source "${YADM_SCRIPTS}/update-common.zsh"

(( _is_work )) && source "${YADM_SCRIPTS}/update-work.zsh"

_step "brew dump" step_brew_dump

_update_finish
