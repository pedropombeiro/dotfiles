#!/usr/bin/env zsh

YADM_SCRIPTS=$( cd -- "$( dirname -- ${(%):-%x} )/../scripts" &> /dev/null && pwd )

source "${YADM_SCRIPTS}/update-ui.zsh"

_update_init ${(%):-%x} "${YADM_SCRIPTS}/update-common.zsh"
_update_require_sudo
_update_track apt brew mise npm nvim mason

# Steps run without a terminal on stdin, so answer apt's prompt up front.
step_apt() {
  sudo apt update
  sudo apt upgrade -y
}

step_brew() {
  brew update
  brew upgrade
}

_step "apt" step_apt
_step "brew" step_brew

source "${YADM_SCRIPTS}/update-common.zsh"

_update_finish
