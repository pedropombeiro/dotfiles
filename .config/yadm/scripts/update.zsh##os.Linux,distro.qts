#!/usr/bin/env zsh

YADM_SCRIPTS=$( cd -- "$( dirname -- ${(%):-%x} )/../scripts" &> /dev/null && pwd )

# PROGRESS_OFFSET and PROGRESS_RANGE let a caller map this run onto part of its
# own iTerm2 progress bar; update-ui.zsh reads them.
source "${YADM_SCRIPTS}/update-ui.zsh"

_update_init ${(%):-%x} "${YADM_SCRIPTS}/update-common.zsh"
_update_track opkg mise npm

export MISE_INSTALL_ARCH=x64-musl

step_entware() {
  opkg update
  opkg upgrade
}

step_mise() {
  yes | mise self-update
  (cd ~ && mise plugin update && mise install --yes && mise upgrade --yes)
}

step_grc_rs() {
  (cd ~ && mise run grc-rs:sync)
}

step_tmux_plugins() {
  local tpm_bin="${XDG_DATA_HOME:-${HOME}/.local/share}/tmux/plugins/tpm/bin"
  "${tpm_bin}/update_plugins" all
  "${tpm_bin}/clean_plugins"
}

step_container_hooks() {
  (cd /share/Container && hk install --mise)
}

_step "entware" step_entware
_step "mise" step_mise
_step "grc-rs rules" step_grc_rs
_step "tmux plugins" step_tmux_plugins
_step "container hk hooks" step_container_hooks

source "${YADM_SCRIPTS}/update-common.zsh"

_update_finish
