# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Line length for the file types formatted in this repo. Prettier reads it as
# its print width. It is not set under [*] because repos under ~ without their
# own root .editorconfig inherit this file.
[{*.{go,js,json,py,yaml,yml},.gitconfig,Makefile,*.mk}]
max_line_length = 120

# Matches multiple files with brace expansion notation
# Set default charset
[*.{go,js}]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true

[*.lua]
quote_style = double

# Tab indentation (no size specified)
[{Makefile,*.mk}]
indent_style = tab

# 4 space indentation
[*.py]
charset = utf-8
indent_style = space
indent_size = 4

[*.yaml]
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
