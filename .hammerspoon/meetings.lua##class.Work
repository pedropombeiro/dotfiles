local audio = require("audio")
local busylight = require("busylight")
local constants = require("constants")
local webcam = require("webcam")
local log = hs.logger.new("meetings", "info")
-- Keep restoration intent across config reloads, including reloads mid-meeting.
local spotifyStateKey = "meetings.spotifyWasPlaying"
local eqMacStateKey = "meetings.eqMacWasRunning"
local connectTask = nil
local pollTimer = nil

local M = {}

local activeMeetings = {}

local function stopPollTimer()
  if pollTimer then
    pollTimer:stop()
    pollTimer = nil
  end
end

local function findAirpods()
  for _, dev in ipairs(hs.audiodevice.allOutputDevices()) do
    if string.find(dev:name(), constants.airpodsPattern, 1, true) then return dev end
  end
end

local function switchToAirpods(current)
  local airpods = findAirpods()
  if not airpods then return false end
  airpods:setDefaultOutputDevice()
  log.i("Switched audio output to " .. airpods:name())
  return true
end

local function connectAndSwitch(current)
  log.i("AirPods not connected, requesting connection via blueutil")
  connectTask = hs.task.new(constants.blueutil, function(exitCode, _, stdErr)
    connectTask = nil
    if exitCode ~= 0 then
      log.w("blueutil --connect failed (exit " .. tostring(exitCode) .. "): " .. tostring(stdErr))
      return
    end
    local attempts = 0
    local function trySwitch()
      attempts = attempts + 1
      if switchToAirpods(current) then
        stopPollTimer()
      elseif attempts >= 10 then
        log.w("AirPods did not appear after connection, giving up")
        stopPollTimer()
      end
    end
    trySwitch()
    if not findAirpods() then pollTimer = hs.timer.doEvery(1, trySwitch) end
  end, { "--connect", constants.airpodsAddress })
  connectTask:start()
end

local function onMeetingStart()
  webcam.on("onMeetingStart")

  local current = hs.audiodevice.defaultOutputDevice()
  if current and string.find(current:name(), constants.airpodsPattern, 1, true) then
    log.i("AirPods already default, skipping switch")
  elseif not switchToAirpods(current) then
    connectAndSwitch(current)
  end

  if hs.spotify.isPlaying() then
    hs.settings.set(spotifyStateKey, true)
    hs.spotify.pause()
    log.i("Paused Spotify")
  end

  local eqMac = hs.application.get("eqMac")
  if eqMac then
    hs.settings.set(eqMacStateKey, true)
    eqMac:kill()
    log.i("Quit eqMac")
  end
end

local function resumeSpotify()
  if hs.settings.get(spotifyStateKey) then
    hs.spotify.play()
    hs.settings.set(spotifyStateKey, false)
    log.i("Resumed Spotify")
  end
end

local function restoreMeetingAudio()
  if hs.settings.get(eqMacStateKey) then
    local output, success, _, exitCode = hs.execute("open -g -a eqMac 2>&1")
    if not success then
      log.e("Could not relaunch eqMac (exit " .. tostring(exitCode) .. "): " .. tostring(output))
      return
    end
    hs.settings.set(eqMacStateKey, false)
    log.i("Relaunched eqMac in background")
    audio.setDockedAudioOutput(resumeSpotify)
  else
    resumeSpotify()
  end
end

local function onMeetingEnd()
  webcam.off("onMeetingEnd")
  restoreMeetingAudio()

  local camo = hs.application.get("Camo Studio")
  if camo then
    camo:kill()
    log.i("Quit Camo Studio")
  end

  -- Keep the shared USB hub powered; blank the light through its API.
  busylight.off("onMeetingEnd")
end

M._watcher = hs.application.watcher.new(function(name, event)
  if not webcam.apps[name] then return end
  if event ~= hs.application.watcher.launched and event ~= hs.application.watcher.terminated then return end

  local previouslyActive = next(activeMeetings) ~= nil

  -- Derive per-app state from the authoritative event, not hs.application.get,
  -- which races against process reaping on terminated and may still report a
  -- dying app (and would miss already-running background processes).
  if event == hs.application.watcher.launched then
    activeMeetings[name] = true
  else
    activeMeetings[name] = nil
  end

  local nowActive = next(activeMeetings) ~= nil

  if nowActive and not previouslyActive then
    onMeetingStart()
  elseif previouslyActive and not nowActive then
    onMeetingEnd()
  end
end)

M._watcher:start()

-- Seed state so a reload mid-meeting does not fire a spurious onMeetingStart.
for _, appName in ipairs(webcam.runningApps()) do
  activeMeetings[appName] = true
end

-- Recover if a meeting ended while Hammerspoon was not watching.
if next(activeMeetings) == nil then restoreMeetingAudio() end

log.i("Meeting watcher started")

return M
