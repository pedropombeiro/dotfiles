local audio = require("audio")
local constants = require("constants")
local spaces = require("spaces")
local usb = require("usb")
local webcam = require("webcam")

local M = {}

local log = hs.logger.new("sleepwake", "info")
local streamDeckPowered = true
local iterm2BundleID = "com.googlecode.iterm2"
local onePasswordBundleID = "com.1password.1password"
local secureInputCheckDelay = 5
local secureInputRestoreDelay = 0.5
local secureInputRecheckDelay = 1

local function task(path, args, callback) hs.task.new(path, callback, args):start() end

local function cancelSecureInputRecovery()
  for _, key in ipairs({ "_secureInputCheckTimer", "_secureInputRestoreTimer", "_secureInputRecheckTimer" }) do
    if M[key] then
      M[key]:stop()
      M[key] = nil
    end
  end
end

-- 1Password can leave Secure Input enabled after unlock. Briefly focusing
-- 1Password makes it release Secure Input; skip if 1Password is frontmost,
-- because the user may be typing into it.
local function recoverSecureInput(reason)
  if not hs.eventtap.isSecureInputEnabled() then
    log.i("Secure Input: disabled (" .. reason .. ")")
    return
  end

  local onePassword = hs.application.get(onePasswordBundleID)
  if not onePassword then
    log.w("Secure Input: enabled but 1Password is not running (" .. reason .. ")")
    return
  end

  local previous = hs.application.frontmostApplication()
  if previous and previous:bundleID() == onePasswordBundleID then
    log.i("Secure Input: enabled with 1Password frontmost, skipping (" .. reason .. ")")
    return
  end

  log.i("Secure Input: enabled, cycling 1Password focus (" .. reason .. ")")
  onePassword:activate()

  M._secureInputRestoreTimer = hs.timer.doAfter(secureInputRestoreDelay, function()
    M._secureInputRestoreTimer = nil
    if previous then previous:activate() end

    M._secureInputRecheckTimer = hs.timer.doAfter(secureInputRecheckDelay, function()
      M._secureInputRecheckTimer = nil
      if hs.eventtap.isSecureInputEnabled() then
        log.w("Secure Input: still enabled after 1Password focus cycle (" .. reason .. ")")
      else
        log.i("Secure Input: cleared by 1Password focus cycle (" .. reason .. ")")
      end
    end)
  end)
end

local function scheduleSecureInputRecovery(reason)
  cancelSecureInputRecovery()
  M._secureInputCheckTimer = hs.timer.doAfter(secureInputCheckDelay, function()
    M._secureInputCheckTimer = nil
    recoverSecureInput(reason)
  end)
end

local function streamDeckOff()
  if not streamDeckPowered then return end
  streamDeckPowered = false
  log.i("Stream Deck: powering off")
  usb.power(constants.usbHub, constants.streamDeckPort, "off")
end

local function onSleep()
  log.i("onSleep")
  cancelSecureInputRecovery()
  task("/usr/bin/killall", { "Busylight_HTTP_Mac" })
  streamDeckOff()
end

local function cycleStreamDeck()
  log.i("Stream Deck: cycling")
  usb.cycle(constants.usbHub, constants.streamDeckPort, 4000, function(exitCode, stdout)
    if exitCode ~= 0 then
      log.i("Stream Deck: hub not found (undocked?), skipping cycle")
    elseif stdout:find("Elgato Stream Deck") then
      log.i("Stream Deck: cycle succeeded")
    else
      log.w("Stream Deck: cycle completed, waiting for USB re-enumeration")
    end
  end)
end

function M.restoreServices(reason)
  reason = reason or "manual"
  log.i("restoreServices (" .. reason .. ")")

  cycleStreamDeck()
  audio.setDockedAudioOutput()

  -- Restore power if the Busylight's shared hub was left off.
  usb.power(constants.usbHub, constants.sharedPeripheralPort, "on")

  task("/opt/homebrew/bin/brew", { "services", "restart", "nginx" })
  task("/usr/bin/open", { "-a", "BusylightHTTP" })

  if hs.application.find("Elgato Control Center") then task("/usr/bin/killall", { "Elgato Control Center" }) end

  hs.timer.doAfter(2, function() spaces.applyRectangleLayout() end)
  scheduleSecureInputRecovery(reason)
end

-- Only focus iTerm2 when it is already visible on the unlocked Space.
local function focusITerm2()
  local app = hs.application.get(iterm2BundleID)
  if not app then return end

  local focusedSpace = hs.spaces.focusedSpace()
  for _, win in ipairs(app:visibleWindows()) do
    if win:isStandard() then
      for _, space in ipairs(hs.spaces.windowSpaces(win) or {}) do
        if space == focusedSpace then
          log.i("focusing iTerm2 window: " .. tostring(win:title()))
          win:focus()
          return
        end
      end
    end
  end

  log.i("no visible iTerm2 window on the focused Space")
end

local function onUnlock()
  log.i("onUnlock")
  streamDeckPowered = true
  M.restoreServices("unlock")
  M._unlockFocusTimer = hs.timer.doAfter(3, function()
    M._unlockFocusTimer = nil
    focusITerm2()
  end)
  M._unlockWebcamTimer = hs.timer.doAfter(5, function()
    M._unlockWebcamTimer = nil
    webcam.reconcile("onUnlock+5s")
  end)
end

function M.displaysleep()
  log.i("displaysleep triggered")
  streamDeckOff()
  if hs.spotify.isPlaying() then
    hs.spotify.pause()
    log.i("Paused Spotify")
  end
  hs.caffeinate.lockScreen()
  hs.timer.doAfter(2, function()
    log.i("sleeping display")
    task("/usr/bin/pmset", { "displaysleepnow" })
  end)
end

hs.urlevent.bind("displaysleep", function() M.displaysleep() end)

local eventNames = {
  [hs.caffeinate.watcher.systemDidWake] = "systemDidWake",
  [hs.caffeinate.watcher.systemWillSleep] = "systemWillSleep",
  [hs.caffeinate.watcher.screensDidSleep] = "screensDidSleep",
  [hs.caffeinate.watcher.screensDidWake] = "screensDidWake",
  [hs.caffeinate.watcher.screensDidLock] = "screensDidLock",
  [hs.caffeinate.watcher.screensDidUnlock] = "screensDidUnlock",
  [hs.caffeinate.watcher.sessionDidResignActive] = "sessionDidResignActive",
  [hs.caffeinate.watcher.sessionDidBecomeActive] = "sessionDidBecomeActive",
}

M._caffeinateWatcher = hs.caffeinate.watcher.new(function(event)
  log.i("caffeinate event: " .. (eventNames[event] or tostring(event)))

  if event == hs.caffeinate.watcher.systemWillSleep then
    onSleep()
  elseif event == hs.caffeinate.watcher.screensDidSleep then
    cancelSecureInputRecovery()
    streamDeckOff()
  elseif event == hs.caffeinate.watcher.screensDidLock then
    cancelSecureInputRecovery()
  elseif event == hs.caffeinate.watcher.screensDidUnlock then
    onUnlock()
  end
end)
M._caffeinateWatcher:start()

M._usbWatcher = hs.usb.watcher.new(function(event)
  if event.productName and event.productName:find("Stream Deck") then
    log.i("Stream Deck USB " .. event.eventType .. ": " .. event.productName)
  end
end)
M._usbWatcher:start()

return M
