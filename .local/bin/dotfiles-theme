#!/usr/bin/env python3
"""Resolve and apply the persisted dotfiles theme without shell initialization."""

import argparse
import hashlib
import json
import os
import plistlib
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import uuid
from pathlib import Path
from urllib.request import urlopen
from xml.parsers.expat import ExpatError

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
ROOT = CONFIG / "dotfiles"
TOKEN = re.compile(r"@THEME_([a-z_]+)@")
TARGETS = (
    "bat/config",
    "atuin/config.toml",
    "btop/btop.conf",
    "lazygit/config.yml",
    "lnav/config.json",
    "yazi/theme.toml",
    "git/theme.conf",
    "tmux/theme.conf",
    "tmux/theme-status.conf",
    "trippy/trippy.toml",
    "glow/glow.yml",
)


def load_theme(name=None):
    if name is None:
        name = (ROOT / "theme").read_text().strip()
    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", name):
        raise ValueError(f"Invalid theme identifier: {name!r}")
    profile = ROOT / "themes" / f"{name}.json"
    if not profile.is_file():
        raise ValueError(f"Unsupported theme: {name}")
    values = json.loads(profile.read_text())
    if not isinstance(values, dict) or not all(
        isinstance(key, str) and isinstance(value, str) for key, value in values.items()
    ):
        raise ValueError(f"Invalid application mappings: {profile}")
    return name, values


def atomic_write(path, content, mode=0o644):
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        raise ValueError(f"Refusing to replace symlink: {path}")
    if path.exists() and path.read_text() == content:
        if path.stat().st_mode & 0o777 != mode:
            path.chmod(mode)
        return
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w", dir=path.parent, delete=False
        ) as output:
            temporary = Path(output.name)
            output.write(content)
        temporary.chmod(mode)
        temporary.replace(path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def asset_sources(name):
    manifest = ROOT / "themes" / name / "assets.json"
    if not manifest.exists():
        return []
    spec = json.loads(manifest.read_text())
    return spec["sources"]


def asset_revision(spec):
    return {key: spec[key] for key in ("repository", "revision")}


def asset_state_path(name):
    return ROOT / "assets" / f"{name}.json"


def validate_assets(name):
    sources = asset_sources(name)
    if not sources:
        return
    state = asset_state_path(name)
    installed = json.loads(state.read_text()) if state.exists() else {}
    for spec in sources:
        for target in spec["files"]:
            # iTerm2 palettes are runtime inputs only on configured Macs.
            if target.startswith("iterm2/") and not iterm2_enabled():
                continue
            path = CONFIG / target
            expected = installed.get(target, {})
            if (
                not path.is_file()
                or expected.get("source") != asset_revision(spec)
                or expected.get("sha256")
                != hashlib.sha256(path.read_bytes()).hexdigest()
            ):
                raise ValueError(
                    f"Missing or outdated theme asset: {target}. "
                    f"Run dotfiles-theme install {name}, then dotfiles-theme apply"
                )


def render_tmux(values):
    tmux_palette = ROOT / "themes" / values["tmux"] / "tmux.json"
    if tmux_palette.exists():
        colors = json.loads(tmux_palette.read_text())
        for key, template in (
            ("tmux_config", "palette.conf.theme"),
            ("tmux_status", "status.conf.theme"),
        ):
            values[key] = TOKEN.sub(
                lambda match: colors[match[1]],
                (CONFIG / "tmux" / template).read_text(),
            ).rstrip("\n")
    else:
        values["tmux_config"] = (
            (CONFIG / "tmux/themes" / f"{values['tmux']}.conf").read_text().rstrip("\n")
        )
        values["tmux_status"] = (
            (CONFIG / "tmux/themes" / f"{values['tmux']}-status.conf")
            .read_text()
            .rstrip("\n")
        )


def render(values):
    # Render everything before writing anything, so invalid profiles fail early.
    values = dict(values)
    for key in ("lazygit_colors", "trippy_colors"):
        values[key] = (ROOT / "themes" / values[key]).read_text().rstrip("\n")
    render_tmux(values)
    values["trippy_platform"] = (
        "unprivileged = true" if sys.platform == "darwin" else ""
    )
    values["glow_style"] = (
        str(CONFIG / "glow" / values["glow"])
        if values["glow"].endswith(".json")
        else values["glow"]
    )
    values["yazi_config"] = (
        (CONFIG / "yazi/themes" / values["yazi"]).read_text().rstrip("\n")
        if values["yazi"].endswith(".toml")
        else f'[flavor]\ndark = "{values["yazi"]}"'
    )
    outputs = {}
    for target in TARGETS:
        template = CONFIG / f"{target}.theme"
        outputs[CONFIG / target] = TOKEN.sub(
            lambda match: values[match[1]], template.read_text()
        )
    # The tracked template owns defaults. A local overlay owns interactive edits.
    btop = CONFIG / "btop/btop.conf"
    previous = ROOT / "btop-rendered.conf"
    overlay_path = CONFIG / "btop/local.json"
    overlay = json.loads(overlay_path.read_text()) if overlay_path.exists() else {}
    if not isinstance(overlay, dict):
        raise TypeError(f"Expected a settings object in {overlay_path}")

    def settings(content):
        return dict(re.findall(r"^([a-z_]+)\s*=\s*(.*)$", content, re.MULTILINE))

    if btop.exists():
        baseline = settings(
            previous.read_text() if previous.exists() else outputs[btop]
        )
        for key, value in settings(btop.read_text()).items():
            if key != "color_theme" and baseline.get(key) != value:
                overlay[key] = value
    overlay.pop("color_theme", None)
    content = outputs[btop]
    for key, value in overlay.items():
        if (
            not re.fullmatch(r"[a-z_]+", key)
            or not isinstance(value, str)
            or "\n" in value
        ):
            raise ValueError(f"Invalid btop preference in {overlay_path}: {key}")
        content, count = re.subn(
            rf"^{key}\s*=.*$",
            lambda _, k=key, v=value: f"{k} = {v}",
            content,
            flags=re.MULTILINE,
        )
        if not count:
            content += f"\n{key} = {value}\n"
    outputs[btop] = content
    outputs[previous] = content
    outputs[overlay_path] = json.dumps(overlay, indent=2) + "\n"
    # Adapt the shared semantic lnav layout when a color map is supplied.
    if "color_map" in values:
        config = json.loads(outputs[CONFIG / "lnav/config.json"])
        original = config["ui"]["theme-defs"][values["lnav"]]
        colors = json.loads((ROOT / "themes" / values["color_map"]).read_text())
        config["ui"]["theme-defs"][values["lnav"]] = json.loads(
            replace_colors(json.dumps(original), colors)
        )
        outputs[CONFIG / "lnav/config.json"] = json.dumps(config, indent=2) + "\n"
    opencode = CONFIG / "opencode/cli.json"
    outputs[opencode] = render_opencode(opencode, values["opencode"])
    outputs.update(render_iterm2(values["iterm"]))
    return outputs


def iterm2_enabled():
    return (
        sys.platform == "darwin" and (CONFIG / "iterm2/dynamic-profiles.json").is_file()
    )


def read_iterm2_plist(path):
    try:
        return plistlib.loads(path.read_bytes())
    except (ExpatError, plistlib.InvalidFileException):
        # Apple's plist reader accepts control characters in iTerm2 key bindings
        # that strict XML parsers reject. Never rewrite the preferences to fix it.
        result = subprocess.run(
            ["plutil", "-convert", "json", "-o", "-", str(path)],
            capture_output=True,
            text=True,
            check=True,
        )
        return json.loads(result.stdout)


def thin_clone_aliases(data):
    if (
        not isinstance(data, list)
        or not all(
            isinstance(alias, str)
            and re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}", alias)
            for alias in data
        )
        or len(data) != len(set(data))
    ):
        raise ValueError("Invalid or duplicate pgai aliases")
    return sorted(data)


def thin_clone_inventory():
    path = CONFIG / "iterm2/thin-clones.local.json"
    if not path.exists():
        return None
    data = json.loads(path.read_text())
    if (
        not isinstance(data, dict)
        or set(data) != {"version", "aliases"}
        or data["version"] != 1
    ):
        raise ValueError("Invalid thin-clone inventory")
    return thin_clone_aliases(data["aliases"])


def refresh_thin_clones(dry_run=False, allow_removed=False):
    if not iterm2_enabled():
        raise ValueError("Thin-clone refresh requires configured iTerm2 on macOS")
    # This is the only discovery path: pgai may unlock its local store via 1Password.
    # Never forward raw output or errors, which can contain private connection data.
    try:
        result = subprocess.run(
            ["mise", "x", "ruby", "--", "pgai", "env", "list"],
            capture_output=True,
            text=True,
            check=False,
            timeout=120,
        )
    except (OSError, subprocess.TimeoutExpired):
        raise ValueError(
            "pgai environment discovery unavailable; inventory unchanged"
        ) from None
    if result.returncode:
        raise ValueError("pgai environment discovery failed; inventory unchanged")
    try:
        records = json.loads(result.stdout)
        if not isinstance(records, list) or not all(
            isinstance(row, dict) for row in records
        ):
            raise ValueError
        aliases = thin_clone_aliases([row.get("alias") for row in records])
    except (ValueError, TypeError):
        raise ValueError(
            "Invalid pgai environment output; inventory unchanged"
        ) from None
    mappings = json.loads((CONFIG / "iterm2/dynamic-profiles.json").read_text())
    previous = thin_clone_inventory()
    if previous is None:
        previous = list(mappings["thin_clones"]["legacy"])
    removed = sorted(set(previous) - set(aliases))
    print("Thin-clone aliases: " + (", ".join(aliases) or "(none)"))
    if removed:
        print("Removed aliases: " + ", ".join(removed))
        if not allow_removed and not dry_run:
            raise ValueError(
                "Review removals with --dry-run, then pass --allow-removed"
            )
    if not dry_run:
        atomic_write(
            CONFIG / "iterm2/thin-clones.local.json",
            json.dumps({"version": 1, "aliases": aliases}, indent=2) + "\n",
            mode=0o600,
        )
        print("Inventory saved. Preview before running mise iterm:profiles:apply.")


def iterm2_mappings(mappings):
    aliases = thin_clone_inventory() if "thin_clones" in mappings else None
    if aliases is None:
        return mappings["profiles"]
    spec = mappings["thin_clones"]
    legacy = spec["legacy"]
    profiles = [
        p
        for p in mappings["profiles"]
        if p["guid"] not in {item["guid"] for item in legacy.values()}
    ]
    for alias in aliases:
        identity = legacy.get(alias, {})
        quoted = shlex.quote(alias)
        profiles.append(
            {
                "name": identity.get("name", f"Postgres thin clone ({alias})"),
                "guid": identity.get("guid")
                or str(uuid.uuid5(uuid.UUID(spec["namespace"]), alias)).upper(),
                "parent_guid": spec["parent_guid"],
                "optional": True,
                "overrides": {
                    "Custom Command": "No",
                    "Initial Text": (
                        'export PATH="$HOME/.shellrc/zshrc.d/functions/scripts:$PATH" && '
                        f"mise x ruby -- pgai connect {quoted}; mise x ruby -- pgai destroy {quoted}"
                    ),
                    "Shortcut": identity.get("shortcut", ""),
                },
            }
        )
    return profiles


def local_iterm2_data(filename):
    path = CONFIG / "iterm2" / filename
    if not path.exists():
        return None
    data = json.loads(path.read_text())
    if not isinstance(data, dict) or data.get("version") != 1:
        raise ValueError(f"Invalid local iTerm2 data: {filename}")
    return data


def refresh_caproni(root=None, legacy=None, dry_run=False, allow_removed=False):
    if not iterm2_enabled():
        raise ValueError("Caproni refresh requires configured iTerm2 on macOS")
    previous = local_iterm2_data("caproni.local.json") or {}
    root = (
        Path(
            root
            or previous.get("root")
            or os.environ.get("CAPRONI_ENV_ROOT", Path.home())
        )
        .expanduser()
        .resolve()
    )
    if not root.is_dir():
        raise ValueError("Caproni root unavailable; inventory unchanged")
    legacy = previous.get("legacy", []) if legacy is None else legacy
    legacy = sorted({str(Path(path).expanduser().resolve()) for path in legacy})
    paths = {
        path.resolve()
        for path in root.glob("cap-*")
        if re.fullmatch(r"cap-[0-9]{1,18}", path.name)
        and (path / "caproni.yaml").is_file()
    }
    for path in legacy:
        if not (Path(path) / "caproni.yaml").is_file():
            raise ValueError(
                "Registered legacy Caproni environment unavailable; inventory unchanged"
            )
        paths.add(Path(path))
    environments = [{"name": path.name, "path": str(path)} for path in sorted(paths)]
    if len({item["name"] for item in environments}) != len(environments):
        raise ValueError("Duplicate Caproni environment names")
    removed = {item["path"] for item in previous.get("environments", [])} - {
        item["path"] for item in environments
    }
    print(f"Caproni environments: {len(environments)}; removed: {len(removed)}")
    if removed and not (allow_removed or dry_run):
        raise ValueError("Review removals with --dry-run, then pass --allow-removed")
    if not dry_run:
        # Validate the projected records before replacing any previous inventory.
        for item in environments:
            if not re.fullmatch(
                r"[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}", item["name"]
            ) or any(char in item["path"] for char in "\n\r\0"):
                raise ValueError("Invalid Caproni environment path")
        atomic_write(
            CONFIG / "iterm2/caproni.local.json",
            json.dumps(
                {
                    "version": 1,
                    "root": str(root),
                    "legacy": legacy,
                    "environments": environments,
                },
                indent=2,
            )
            + "\n",
            mode=0o600,
        )


def caproni_mappings(mappings):
    data = local_iterm2_data("caproni.local.json")
    if data is None:
        return []
    if set(data) != {"version", "root", "legacy", "environments"} or not isinstance(
        data["environments"], list
    ):
        raise ValueError("Invalid Caproni inventory")
    profiles = []
    for item in data["environments"]:
        if (
            not isinstance(item, dict)
            or set(item) != {"name", "path"}
            or not isinstance(item["name"], str)
            or not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}", item["name"])
            or not isinstance(item["path"], str)
            or not Path(item["path"]).is_absolute()
            or any(char in item["path"] for char in "\n\r\0")
        ):
            raise ValueError("Invalid Caproni environment")
        profiles.append(
            {
                "name": f"Caproni ({item['name']})",
                "guid": str(
                    uuid.uuid5(
                        uuid.UUID("5911fb44-4c51-413b-b787-682123c1d53b"), item["path"]
                    )
                ).upper(),
                "parent_guid": next(
                    p["parent_guid"]
                    for p in mappings["profiles"]
                    if p["name"] == "Default"
                ),
                "optional": True,
                "overrides": {
                    "Custom Command": "Yes",
                    "Command": "/bin/zsh -l",
                    "Initial Text": "",
                    "Working Directory": item["path"],
                    "Custom Directory": "Yes",
                    "Shortcut": "",
                    "Icon": 2,
                    "Custom Icon Path": str(CONFIG / "iterm2/icons/caproni.ico"),
                },
            }
        )
    return profiles


def workspace_mappings(mappings):
    profiles = iterm2_mappings(mappings)
    gdk = local_iterm2_data("gdk.local.json")
    if gdk is not None:
        if set(gdk) != {"version", "profiles"} or not isinstance(gdk["profiles"], dict):
            raise ValueError("Invalid GDK overrides")
        allowed = {
            p["guid"]
            for p in mappings["profiles"]
            if p["name"].startswith("GDK") or p["name"] == "Clickhouse client"
        }
        if not gdk["profiles"].keys() <= allowed:
            raise ValueError("Unexpected GDK profile identity")
        for entry in gdk["profiles"].values():
            if (
                not isinstance(entry, dict)
                or set(entry) != {"parent_guid", "overrides"}
                or not isinstance(entry["parent_guid"], str)
                or not isinstance(entry["overrides"], dict)
                or {
                    "Guid",
                    "Name",
                    "Dynamic Profile Parent GUID",
                    "Dynamic Profile Filename",
                }
                & entry["overrides"].keys()
            ):
                raise ValueError("Invalid GDK role overrides")
        profiles = [{**p, **gdk["profiles"].get(p["guid"], {})} for p in profiles]
    return profiles + caproni_mappings(mappings)


def preview_iterm2(theme):
    outputs = render_iterm2(theme)
    if not outputs:
        print("No configured iTerm2 profiles on this platform.")
        return
    preferences = read_iterm2_plist(
        CONFIG / "iterm2/config/com.googlecode.iterm2.plist"
    )
    parents = {p["Guid"]: p for p in preferences["New Bookmarks"]}
    mappings = json.loads((CONFIG / "iterm2/dynamic-profiles.json").read_text())
    originals = {p["guid"]: p["parent_guid"] for p in mappings["profiles"]}
    summaries = []
    for content in outputs.values():
        for profile in json.loads(content)["Profiles"]:
            summary = {
                key: profile[key]
                for key in (
                    "Name",
                    "Guid",
                    "Dynamic Profile Parent GUID",
                    "Custom Command",
                    "Initial Text",
                    "Shortcut",
                )
                if key in profile
            }
            original = parents.get(originals.get(profile["Guid"]))
            if original:
                previous = {**original, **profile}
                if (
                    profile["Name"].startswith("GDK")
                    or profile["Name"] == "Clickhouse client"
                ):
                    # Compare migrated role overrides against their original values,
                    # rather than applying those overrides to both sides.
                    previous = {
                        **original,
                        **{
                            key: value
                            for key, value in profile.items()
                            if key.endswith(" Color")
                            or key
                            in {
                                "Guid",
                                "Name",
                                "Use Separate Colors for Light and Dark Mode",
                            }
                        },
                    }
                current = {**parents[profile["Dynamic Profile Parent GUID"]], **profile}
                # Report preference keys only, never private inherited values.
                summary["Changed inherited preference keys"] = sorted(
                    key
                    for key in previous.keys() | current.keys()
                    if previous.get(key) != current.get(key)
                    and not key.endswith((" Color (Dark)", " Color (Light)"))
                    and key
                    not in {
                        "Guid",
                        "Name",
                        "Dynamic Profile Filename",
                        "Dynamic Profile Parent GUID",
                    }
                )
            summaries.append(summary)
    print(json.dumps(summaries, indent=2))


def is_generated_iterm2_profile(profile, target):
    # Compare by file name: exported preferences keep the absolute path of the
    # machine that wrote them, which differs on CI and other home directories.
    filename = profile.get("Dynamic Profile Filename")
    return bool(filename) and Path(filename).name == target.name


def render_iterm2(theme):
    if not iterm2_enabled():
        return {}
    preferences = CONFIG / "iterm2/config/com.googlecode.iterm2.plist"
    # Bootstrap may render themes before iTerm2 preferences are installed.
    if not preferences.exists():
        return {}
    target = (
        Path.home()
        / "Library/Application Support/iTerm2/DynamicProfiles/dotfiles-theme.json"
    )
    # iTerm2 can persist loaded Dynamic Profiles alongside regular bookmarks.
    # Only our generated file's copies may reuse the managed child GUIDs.
    parents = {
        profile["Guid"]
        for profile in read_iterm2_plist(preferences)["New Bookmarks"]
        if not is_generated_iterm2_profile(profile, target)
    }
    # Other watched files need not have been persisted into preferences yet.
    external_names = set()
    external_guids = set()
    for path in target.parent.iterdir() if target.parent.exists() else ():
        if path.resolve() == target.resolve() or not path.is_file():
            continue
        try:
            document = json.loads(path.read_text())
        except (ValueError, UnicodeError):
            document = read_iterm2_plist(path)
        for profile in document.get("Profiles", []):
            external_guids.add(profile["Guid"])
            external_names.add(profile["Name"])
    mappings = json.loads((CONFIG / "iterm2/dynamic-profiles.json").read_text())
    palette = read_iterm2_plist(CONFIG / "iterm2/themes" / f"{theme}.itermcolors")
    required = {
        "Background Color",
        "Foreground Color",
        "Cursor Color",
        "Cursor Text Color",
        "Selection Color",
        "Selected Text Color",
        *(f"Ansi {index} Color" for index in range(16)),
    }
    if not isinstance(palette, dict) or not required <= palette.keys():
        raise ValueError(f"Incomplete iTerm2 palette: {theme}")
    # Import colors only, never commands, fonts, identities, or layout preferences.
    colors = {
        key: value
        for key, value in palette.items()
        if key.endswith(" Color") and isinstance(value, dict)
    }
    profiles = []
    guids = parents | external_guids
    names = external_names | {
        profile["Name"]
        for profile in read_iterm2_plist(preferences)["New Bookmarks"]
        if not is_generated_iterm2_profile(profile, target)
    }
    for mapping in workspace_mappings(mappings):
        parent = mapping["parent_guid"]
        if parent not in parents:
            if mapping.get("optional", False):
                continue
            raise ValueError(f"Missing iTerm2 parent profile: {parent}")
        guid = mapping["guid"]
        if guid in guids:
            raise ValueError(f"Duplicate iTerm2 profile GUID: {guid}")
        guids.add(guid)
        if mapping["name"] in names:
            raise ValueError("Duplicate generated iTerm2 profile name")
        names.add(mapping["name"])
        profiles.append(
            {
                "Name": mapping["name"],
                "Guid": guid,
                "Dynamic Profile Parent GUID": parent,
                **mapping.get("overrides", {}),
                "Use Separate Colors for Light and Dark Mode": False,
                **colors,
            }
        )
    return {target: json.dumps({"Profiles": profiles}, indent=2) + "\n"}


def render_opencode(opencode, theme):
    # OpenCode owns its live preferences; change only the theme name and mode.
    preferences = (
        json.loads(opencode.read_text())
        if opencode.exists()
        else {"$schema": "https://opencode.ai/v2/cli.json"}
    )
    if not isinstance(preferences, dict) or not isinstance(
        preferences.get("theme", {}), dict
    ):
        raise TypeError(f"Expected OpenCode settings and theme objects in {opencode}")
    preferences.setdefault("theme", {}).update(name=theme, mode="dark")
    return json.dumps(preferences, indent=2) + "\n"


def replace_colors(content, colors):
    return re.sub(r"#[0-9a-fA-F]{6}", lambda m: colors.get(m[0].lower(), m[0]), content)


def lua_table(values):
    return (
        "{\n"
        + "".join(
            f"  [{json.dumps(key)}] = {json.dumps(value)},\n"
            for key, value in values.items()
        )
        + "}"
    )


def install_assets(name):
    outputs = {}
    installed = {}
    for spec in asset_sources(name):
        base = f"https://raw.githubusercontent.com/{spec['repository']}/{spec['revision']}/"
        for target, source in spec["files"].items():
            with urlopen(base + source, timeout=30) as response:
                content = response.read().decode()
                outputs[CONFIG / target] = content
                installed[target] = {
                    "source": asset_revision(spec),
                    "sha256": hashlib.sha256(content.encode()).hexdigest(),
                }
    for target, content in outputs.items():
        atomic_write(target, content)
    if shutil.which("bat"):
        subprocess.run(["bat", "cache", "--build"], check=True)
    atomic_write(asset_state_path(name), json.dumps(installed, indent=2) + "\n")


def shell_exports(name, values):
    exports = {
        "DOTFILES_THEME": name,
        "BAT_THEME": values["bat"],
        "HIGHLIGHT_STYLE": values["highlight"],
        "NVIM_THEME": values["nvim"],
        "XH_STYLE": values["xh"],
        "FZF_DEFAULT_COLOR": values["fzf"],
    }
    return "".join(
        f"export {key}={shlex.quote(value)}\n" for key, value in exports.items()
    )


def render_prompt(profile):
    palettes = {}
    for path in (ROOT / "themes").glob("*/prompt.json"):
        palette = json.loads(path.read_text())
        if not isinstance(palette, dict) or not all(
            isinstance(key, str)
            and re.fullmatch(
                r"(?:POWERLEVEL9K_[A-Z0-9_]+|ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE)", key
            )
            and isinstance(value, str)
            for key, value in palette.items()
        ):
            raise ValueError(f"Invalid prompt palette: {path}")
        palettes[path.relative_to(ROOT / "themes").as_posix()] = palette
    # Reset the union of explicitly managed variables before changing palettes.
    variables = sorted({key for palette in palettes.values() for key in palette})
    reset = "unset " + " ".join(variables) + "\n" if variables else ""
    return (
        "# Generated by dotfiles-theme apply.\n"
        + reset
        + "".join(
            f"typeset -g {key}={shlex.quote(value)}\n"
            for key, value in palettes[profile].items()
        )
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("get", help="Print the persisted theme")
    sub.add_parser("list", help="List installed theme profiles")
    install = sub.add_parser(
        "install", help="Fetch pinned assets missing from native tools"
    )
    install.add_argument("name", nargs="?", help="Defaults to the selected theme")
    value = sub.add_parser("value", help="Print an application mapping")
    value.add_argument("key")
    sub.add_parser("shell", help="Print shell exports for the selected theme")
    refresh = sub.add_parser(
        "iterm-refresh", help="Cache pgai aliases without opening connections"
    )
    refresh.add_argument(
        "--dry-run", action="store_true", help="Discover and report without saving"
    )
    refresh.add_argument(
        "--allow-removed",
        action="store_true",
        help="Accept removed aliases after review",
    )
    sub.add_parser(
        "iterm-preview",
        help="Preview generated identities and launch settings without writing",
    )
    sub.add_parser(
        "iterm-apply", help="Write only iTerm2 profiles using the selected theme"
    )
    caproni = sub.add_parser(
        "iterm-caproni-refresh", help="Cache local Caproni environment directories"
    )
    caproni.add_argument(
        "--root", help="Environment root, defaults to CAPRONI_ENV_ROOT or home"
    )
    caproni.add_argument(
        "--legacy",
        action="append",
        help="Register a legacy environment path; repeatable",
    )
    caproni.add_argument(
        "--dry-run", action="store_true", help="Inspect without saving"
    )
    caproni.add_argument(
        "--allow-removed",
        action="store_true",
        help="Accept reviewed environment removals",
    )
    apply = sub.add_parser("apply", help="Render managed configs")
    apply.add_argument("--reload", action="store_true", help="Also reload running tmux")
    select = sub.add_parser("set", help="Persist a theme and render managed configs")
    select.add_argument("name")
    select.add_argument(
        "--reload", action="store_true", help="Also reload running tmux"
    )
    args = parser.parse_args()

    if args.command == "list":
        print("\n".join(sorted(path.stem for path in (ROOT / "themes").glob("*.json"))))
        return
    if args.command == "iterm-refresh":
        refresh_thin_clones(args.dry_run, args.allow_removed)
        return
    if args.command == "iterm-caproni-refresh":
        refresh_caproni(args.root, args.legacy, args.dry_run, args.allow_removed)
        return
    name, values = load_theme(args.name if args.command in ("set", "install") else None)
    if args.command == "iterm-preview":
        preview_iterm2(values["iterm"])
    elif args.command == "iterm-apply":
        outputs = render_iterm2(values["iterm"])
        for path, content in outputs.items():
            atomic_write(path, content, mode=0o600)
        print(
            "iTerm2 profiles updated."
            if outputs
            else "No configured iTerm2 profiles on this platform."
        )
    elif args.command == "get":
        print(name)
    elif args.command == "value":
        print(values[args.key])
    elif args.command == "shell":
        print(shell_exports(name, values), end="")
    elif args.command == "install":
        install_assets(name)
        print(f"Installed assets for {name}.")
    else:
        validate_assets(name)
        outputs = render(values)
        # Keep the generated descriptor consistent with a newly selected theme.
        outputs[ROOT / "theme.json"] = (
            json.dumps({"name": name, **values}, indent=2) + "\n"
        )
        outputs[ROOT / "theme.sh"] = shell_exports(name, values)
        outputs[ROOT / "prompt.zsh"] = render_prompt(values["zsh"])
        outputs[ROOT / "yazi-theme.lua"] = (
            "-- Generated by dotfiles-theme apply.\nreturn {\n"
            f"  yatline = {json.dumps(values['yatline'])},\n"
            f"  style = {json.dumps(values['yatline_style'])},\n"
            "}\n"
        )
        yatline = ROOT / "themes" / name / "yatline.json"
        if yatline.exists():
            outputs[ROOT / "yatline.lua"] = (
                "-- Generated by dotfiles-theme apply.\nreturn "
                + lua_table(json.loads(yatline.read_text()))
                + "\n"
            )
        if args.command == "set":
            outputs[ROOT / "theme"] = name + "\n"
        for path in outputs:
            if path.is_symlink():
                raise ValueError(f"Refusing to replace symlink: {path}")
        for path, content in outputs.items():
            atomic_write(
                path,
                content,
                mode=0o600 if path.name == "dotfiles-theme.json" else 0o644,
            )
        if (
            args.reload
            and shutil.which("tmux")
            and subprocess.run(
                ["tmux", "has-session"], capture_output=True, check=False
            ).returncode
            == 0
        ):
            subprocess.run(
                ["tmux", "source-file", str(CONFIG / "tmux/tmux.conf")], check=True
            )
        print(
            f"Applied {name}. Run theme-refresh in existing Zsh shells "
            "or start a new shell. OpenCode updates live; reopen other applications."
        )
        if any(path.name == "dotfiles-theme.json" for path in outputs):
            print("iTerm2 Dynamic Profiles updated.")


if __name__ == "__main__":
    try:
        main()
    except (
        OSError,
        ValueError,
        TypeError,
        KeyError,
        subprocess.CalledProcessError,
    ) as error:
        print(f"dotfiles-theme: {error}", file=sys.stderr)
        sys.exit(1)
