#!/usr/bin/env sh
# Generate a commit message from a diff using opencode, then commit.
# Reads the diff from stdin or falls back to staged changes.
# Automatically uses yadm instead of git when in the home directory.
#
# Usage:
#   git-ai-commit-msg                    # generate + commit (conventional)
#   git-ai-commit-msg --type feat        # force conventional type
#   git-ai-commit-msg --type none        # plain (non-conventional) commit
#   git-ai-commit-msg --no-commit        # only print the message
#   git diff --cached | git-ai-commit-msg --no-commit

set -e

# Progress indicators are cosmetic, so a missing helper must not abort the commit.
_iterm2_helpers="${HOME}/.config/yadm/scripts/iterm2.sh"
if [ -r "${_iterm2_helpers}" ]; then
  # shellcheck source=../../.config/yadm/scripts/iterm2.sh
  . "${_iterm2_helpers}"
else
  iterm2_progress() { :; }
fi

type=""
do_commit=1
while [ $# -gt 0 ]; do
  case "$1" in
  --type)
    if [ $# -lt 2 ]; then
      echo "error: --type requires a value" >&2
      exit 1
    fi
    type="$2"
    shift 2
    ;;
  --no-commit)
    do_commit=0
    shift
    ;;
  *)
    echo "error: unknown argument: $1" >&2
    exit 1
    ;;
  esac
done

# Use a small model for this text-only task.
model="${OPENCODE_COMMIT_MODEL:-${OPENCODE_MODEL:-gitlab/duo-chat-gpt-5-4-mini}}"

# Fall back to local model when offline
_offline_model="${OPENCODE_OFFLINE_MODEL:-ollama/gemma4:e2b}"
if [ "$model" != "$_offline_model" ] && ! ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1; then
  echo "offline: falling back to $_offline_model" >&2
  model="$_offline_model"
fi
unset _offline_model

# Use yadm when running from the home directory (dotfiles repo).
yadm_repo="${XDG_DATA_HOME:-$HOME/.local/share}/yadm/repo.git"
if [ "$(pwd -P)" = "$(cd "$HOME" && pwd -P)" ] || { [ -d "$yadm_repo" ] && ! git rev-parse --git-dir >/dev/null 2>&1; }; then
  git_cmd="yadm"
else
  git_cmd="git"
fi

# The yadm wrapper takes about 0.7 s per call, while git against its bare
# repository takes about 35 ms. Read-only commands skip the wrapper; only the
# commit itself uses yadm.
read_git() {
  if [ "$git_cmd" = "yadm" ] && [ -d "$yadm_repo" ]; then
    git --git-dir="$yadm_repo" --work-tree="$HOME" "$@"
  else
    $git_cmd "$@"
  fi
}

# Provider settings may contain substituted credentials.
umask 077
run_dir=$(mktemp -d "${TMPDIR:-/tmp}/git-ai-commit-msg.XXXXXX")
tmpfile="$run_dir/diff"
statusfile="$run_dir/staged-status"
msgfile="$run_dir/message"
session_id=""
run_pid=""
progress_active=0
cleanup() {
  result=$?
  trap - EXIT HUP INT TERM
  if [ -n "$run_pid" ]; then
    kill "$run_pid" 2>/dev/null || :
    wait "$run_pid" 2>/dev/null || :
  fi
  if [ "$progress_active" -eq 1 ]; then
    iterm2_progress -c || :
  fi
  if [ -n "$session_id" ]; then
    # Keep the private config alive until session deletion finishes.
    (
      (run_opencode session delete --standalone "$session_id") || :
      rm -rf "$run_dir"
    ) </dev/null >/dev/null 2>&1 &
  else
    rm -rf "$run_dir"
  fi
  exit "$result"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

tmp_opencode_state_root="${TMPDIR:-/tmp}/opencode-state"
tmp_opencode_state="$tmp_opencode_state_root/$(id -u)"
opencode_commit_data_root="${XDG_DATA_HOME:-$HOME/.local/share}"
opencode_commit_data="$opencode_commit_data_root/opencode-commit"
tmp_opencode_state_ttl_seconds=$((7 * 24 * 60 * 60))
if [ -d "$tmp_opencode_state" ]; then
  if mtime=$(stat -f %m "$tmp_opencode_state" 2>/dev/null); then
    :
  else
    mtime=$(stat -c %Y "$tmp_opencode_state")
  fi
  now=$(date +%s)
  if [ $((now - mtime)) -gt "$tmp_opencode_state_ttl_seconds" ]; then
    rm -rf "$tmp_opencode_state"
  fi
fi
mkdir -p "$tmp_opencode_state"

opencode_data_dir="$opencode_commit_data/opencode"
mkdir -p "$opencode_data_dir"
opencode_auth_src="${XDG_DATA_HOME:-$HOME/.local/share}/opencode/auth.json"
if [ -f "$opencode_auth_src" ] && [ ! -e "$opencode_data_dir/auth.json" ]; then
  ln -s "$opencode_auth_src" "$opencode_data_dir/auth.json"
fi

if [ ! -t 0 ]; then
  cat >"$tmpfile"
fi
if [ ! -s "$tmpfile" ]; then
  read_git diff --cached --no-ext-diff --no-color >"$tmpfile"
  read_git diff --cached --name-status --no-ext-diff --no-color >"$statusfile"
fi
if [ ! -s "$tmpfile" ]; then
  echo "error: no diff provided on stdin and no staged changes" >&2
  exit 1
fi

prompt="Based on the attached diff and any staged name/status metadata, write a commit message with a subject line (max 72 chars), blank line, then a body explaining what and why (wrap at 72 chars)."
if [ "$type" != "none" ]; then
  if [ -n "$type" ]; then
    prompt="$prompt Use conventional commit format. The subject line must be '$type(<scope>): <subject>'. Derive the scope from the primary area of the codebase affected (e.g. file, module, or component name). Only omit the scope if the change is truly global."
  else
    prompt="$prompt Use conventional commit format. The subject line must be '<type>(<scope>): <subject>'. Derive the scope from the primary area of the codebase affected (e.g. file, module, or component name). Only omit the scope if the change is truly global. Choose the most appropriate type (feat, fix, chore, refactor, docs, style, test, ci, build, perf)."
  fi
fi
prompt="$prompt CRITICAL: Your response must contain ONLY the commit message itself. No explanations, no preamble, no thinking, no markdown. Start directly with the subject line."

# Preserve mise's real state and data dirs before overriding XDG_STATE_HOME
# and XDG_DATA_HOME for opencode isolation. Must be computed beforehand
# because zsh evaluates command-prefix assignments left-to-right.
mise_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/mise"
mise_data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/mise"

# The run uses a private config directory that holds only the selected
# provider's settings and the commit agent. It excludes global instructions,
# agents, and MCP servers. Deriving it takes about 0.45 s (`opencode debug
# config` plus `jq`), so it is cached per provider and rebuilt when a config
# source changes, after a failed run, or on a new day (which bounds staleness
# after an OpenCode upgrade).
provider="${model%%/*}"
config_root="$opencode_commit_data/config"
config_dir="$config_root/$provider"
config_key_file="$config_root/$provider.key"
config_cached=0

config_sources() {
  _cfg_home="${XDG_CONFIG_HOME:-$HOME/.config}"
  for _f in "${OPENCODE_CONFIG:-}" \
    "$_cfg_home/opencode/opencode.json" "$_cfg_home/opencode/opencode.jsonc" \
    "/Library/Application Support/opencode/opencode.json" \
    "/Library/Application Support/opencode/opencode.jsonc" \
    "/etc/opencode/opencode.json" "/etc/opencode/opencode.jsonc"; do
    if [ -n "$_f" ] && [ -f "$_f" ]; then
      printf '%s\n' "$_f"
    fi
  done
}

# Substitutions such as {env:NAME} and {file:PATH} resolve at load time, so a
# cached copy could go stale without any source file changing.
config_cacheable=1
config_key="$provider $(date +%Y%m%d)"
while IFS= read -r _f; do
  [ -n "$_f" ] || continue
  if grep -Eq '\{(env|file):' "$_f"; then
    config_cacheable=0
  fi
  if _meta=$(stat -Lf '%m %z' "$_f" 2>/dev/null); then
    :
  else
    _meta=$(stat -Lc '%Y %s' "$_f")
  fi
  config_key="$config_key
$_f $_meta"
done <<EOF
$(config_sources)
EOF

# Disabling plugins that this run never uses (tools, sidebar, MCP, and every
# provider except the two this script selects) trims startup by about 0.25 s,
# and skips network work such as the GitHub Copilot model sync. The `dynamic`
# provider plugin is required for `aisdk:` provider packages. Other providers
# keep the full built-in set.
case "$provider" in
gitlab | ollama)
  config_plugins='["-*","opencode.*","-opencode.provider.*","opencode.provider.dynamic","opencode.provider.gitlab","opencode.provider.ollama","-opencode.tool.*","-opencode.sidebar.*","-opencode.home.*","-opencode.mcp.*","-opencode.simulation.*"]'
  ;;
*)
  config_plugins='["-*","opencode.*"]'
  ;;
esac

if [ "$config_cacheable" -eq 0 ]; then
  config_dir="$run_dir/config"
fi
if [ "$config_cacheable" -eq 1 ] && [ -f "$config_dir/opencode.json" ] &&
  [ -f "$config_key_file" ] && [ "$(cat "$config_key_file")" = "$config_key" ]; then
  config_cached=1
else
  mkdir -p "$config_dir"
  # `debug config` normalizes JSONC, substitutions, and provider package
  # overrides. It discovers configuration; it does not submit a model request.
  (
    cd "$run_dir" || exit 1
    OPENCODE_DISABLE_PROJECT_CONFIG=1 \
      OPENCODE_CONFIG_CONTENT='{"plugins":["-*","opencode.*"]}' \
      XDG_DATA_HOME="$opencode_commit_data" XDG_STATE_HOME="$tmp_opencode_state" \
      MISE_STATE_DIR="$mise_state_dir" MISE_DATA_DIR="$mise_data_dir" \
      opencode debug config --standalone >"$run_dir/sources.json"
  )
  jq --arg provider "$provider" --argjson plugins "$config_plugins" '
    (reduce .[] as $source ({}; . * ($source.info.providers // {}))) as $providers |
    {
      providers: (if $providers[$provider] then {($provider): $providers[$provider]} else {} end),
      plugins: $plugins,
      snapshots: false,
      update: "disable",
      agents: {commit: {
        mode: "primary",
        system: "You write git commit messages. Output only the message.",
        permissions: [{action: "*", resource: "*", effect: "deny"}]
      }}
    }
  ' "$run_dir/sources.json" >"$config_dir/opencode.json.$$"
  rm -f "$run_dir/sources.json"
  mv -f "$config_dir/opencode.json.$$" "$config_dir/opencode.json"
  if [ "$config_cacheable" -eq 1 ]; then
    printf '%s\n' "$config_key" >"$config_key_file.$$"
    mv -f "$config_key_file.$$" "$config_key_file"
  fi
fi

# Project discovery is disabled even when TMPDIR is inside a repository.
# --standalone keeps this operation off the shared background service.
run_opencode() {
  cd "$run_dir" || exit 1
  unset OPENCODE_CONFIG
  exec env OPENCODE_TERMINAL_PROGRESS=0 \
    OPENCODE_CONFIG_DIR="$config_dir" \
    OPENCODE_DISABLE_PROJECT_CONFIG=1 \
    OPENCODE_CONFIG_CONTENT='{}' \
    OPENCODE_CLI_CONFIG_CONTENT='{"plugins":["-*"]}' \
    XDG_DATA_HOME="$opencode_commit_data" \
    XDG_STATE_HOME="$tmp_opencode_state" \
    MISE_STATE_DIR="$mise_state_dir" \
    MISE_DATA_DIR="$mise_data_dir" \
    opencode "$@"
}

progress_active=1
iterm2_progress -i || :
session_id="ses_commit$(date +%s)$$"
set -- -f "$tmpfile"
if [ -s "$statusfile" ]; then
  set -- "$@" -f "$statusfile"
fi
# --title skips the extra model call that otherwise generates a session title.
run_opencode run --standalone --session "$session_id" --title commit -m "$model" --agent commit "$prompt" "$@" </dev/null >"$msgfile" &
run_pid=$!
if wait "$run_pid"; then
  run_pid=""
else
  result=$?
  run_pid=""
  # A stale cached config can cause a failure; rebuild it on the next run.
  if [ "$config_cached" -eq 1 ]; then
    rm -f "$config_key_file"
  fi
  exit "$result"
fi
iterm2_progress -c || :
progress_active=0
msg=$(cat "$msgfile")

if ! LC_ALL=C grep -q '[^[:space:]]' "$msgfile"; then
  echo "error: opencode returned an empty response" >&2
  exit 1
fi

if [ "$do_commit" -eq 1 ]; then
  printf "%s\n" "$msg" >"$msgfile"
  printf "\n── commit message ──────────────────────────────────────────────────────\n" >&2
  printf "%s\n" "$msg" >&2
  printf "────────────────────────────────────────────────────────────────────────\n\n" >&2
  $git_cmd commit -F "$msgfile"
else
  printf '%s\n' "$msg"
fi
