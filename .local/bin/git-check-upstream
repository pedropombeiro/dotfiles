#!/usr/bin/env sh
# pre-push check: fail fast when the remote branch has commits that the local
# branch lacks, before slower push checks run. Reads Git's pre-push ref lines
# from stdin: <local ref> <local sha> <remote ref> <remote sha>.
# Bypass with SKIP_UPSTREAM_CHECK=1.

[ "${SKIP_UPSTREAM_CHECK:-0}" = "1" ] && exit 0

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # New remote branches and deletions have nothing to fall behind.
  [ -z "$remote_sha" ] || [ "$remote_sha" = "$zero" ] || [ "$local_sha" = "$zero" ] && continue
  if git cat-file -e "${remote_sha}^{commit}" 2>/dev/null &&
    git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    continue
  fi
  status=1
  echo "error: ${remote_ref#refs/heads/} on the remote has commits that ${local_ref#refs/heads/} lacks." >&2
  if git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    echo "Incoming commits:" >&2
    git log --oneline "${local_sha}..${remote_sha}" >&2
  fi
done
if [ "$status" -ne 0 ]; then
  echo "Run 'pull --rebase --autostash', review the incoming commits, then push again." >&2
  echo "Bypass with SKIP_UPSTREAM_CHECK=1 for an intended force push." >&2
fi
exit "$status"
