#!/bin/bash
# Wrap `sesh list` for fzf pickers, marking sessions with an OpenCode agent waiting for input.
#
# opencode-tmux-indicator sets the per-window `@opencode-waiting` option. A session is marked
# when any of its windows has it set. Each output row has three tab-separated fields:
#
#   1. the plain session name or directory path, for `sesh connect` and `sesh preview`
#   2. the bare session name, for tmux commands such as `kill-session`
#   3. the display row, with an orange bullet for waiting sessions and the active window
#
# Pickers use `--delimiter '\t' --with-nth 3 --accept-nth 1`. All arguments pass through
# to `sesh list`. The all view also includes immediate child directories under
# ~/Developer/github.com/pedropombeiro, independently of zoxide history.

set -o pipefail

icons=false
source_filter=false
for arg in "$@"; do
  case $arg in
  --icons) icons=true ;;
  --config)
    source_filter=true
    ;;
  --tmux | --zoxide | --tmuxinator | --panes) source_filter=true ;;
  -[!-]*)
    [[ $arg == *i* ]] && icons=true
    [[ $arg == *[tczTp]* ]] && source_filter=true
    ;;
  esac
done

# Pass waiting session names to jq without mixing them into the session JSON.
SESH_WAITING=$(tmux list-windows -a -F '#{?@opencode-waiting,#{session_name},}' 2>/dev/null | sort -u)
export SESH_WAITING

sessions=$(sesh list "$@" --json) || exit
{
  printf '%s\n' "$sessions"
  if ! "$source_filter"; then
    shopt -s nullglob
    {
      for project in "$HOME"/Developer/github.com/pedropombeiro/*/; do
        printf '%s\0' "${project%/}"
      done
    } | jq -Rs 'split("\u0000") | map(select(length > 0) | {Src: "directory", Name: ., Path: .})'
  fi
} | jq -rs --argjson icons "$icons" '
  def home: if startswith(env.HOME + "/") then "~" + ltrimstr(env.HOME) else . end;
  def pathkey: sub("^~/"; env.HOME + "/") | sub("/+$"; "");
  def clean: gsub("[\t\r\n]"; " ");
  def glyph:
    {tmux: "", config: "", zoxide: "", tmuxinator: "", "tmux-pane": "", directory: "📁"}[.Src] // "";
  add as $sessions
  | (env.SESH_WAITING | split("\n")) as $waiting
  | ([$sessions[] | select(.Src == "tmux") | .Path // "" | select(length > 0) | pathkey]) as $tmuxpaths
  | reduce $sessions[] as $s ({seen: {}, rows: []};
      ($s.Path // "" | pathkey) as $path
      | (if $s.Src == "tmux" or $s.Src == "config" then $s.Src + ":" + $s.Name elif $path != "" then $path else $s.Src + ":" + $s.Name end) as $key
      | if .seen[$key] or (($s.Src == "zoxide" or $s.Src == "directory") and $path != "" and ($tmuxpaths | index($path)) != null) then .
        else .seen[$key] = true | .rows += [$s] end)
  | .rows[]
  | (if .Src == "directory" then .Path | home else .Name end) as $name
  | ([.TmuxWindows[]? | select(.Active) | .Name][0] // "") as $window
  | (if $icons then ((.Icon | select(. != null and . != "")) // glyph) + " " else "" end) as $prefix
  | (if .Src == "tmux" and ($waiting | index($name)) != null then "\u001b[38;5;214m●\u001b[39m " else "  " end) as $marker
  | [$name, $name, ($prefix + $marker + $name + (if $window != "" then "  \u001b[90m[" + ($window | clean) + "]\u001b[39m" else "" end))]
  | join("\t")
'
