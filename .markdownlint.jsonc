{
  // Default state for all rules
  "default": true,
  "MD013": {
    // Matches `max_line_length` in .editorconfig, which markdownlint does not read
    "line_length": 120,
    // Number of characters for headings
    "heading_line_length": 80,
    // Number of characters for code blocks
    "code_block_line_length": 280,
    // Include code blocks
    "code_blocks": true,
    // Exclude tables: aligned rows pad to the longest cell and cannot be wrapped
    "tables": false,
    // Include headings
    "headings": true,
    // Include headings
    "headers": true,
    // Strict length checking
    "strict": false,
    // Stern length checking
    "stern": false
  },
  // MD031/blanks-around-fences - Allow fences inside list items without blank
  // lines, which would otherwise turn a tight list into a loose one
  "MD031": {
    "list_items": false
  },
  // MD007/ul-indent - Unordered list indentation
  "MD007": {
    "indent": 2
  },
  // MD025/single-title/single-h1 - Multiple top-level headings in the same document
  "MD025": {
    // Heading level
    "level": 1,
    // RegExp for matching title in front matter
    "front_matter_title": "^\\s*title\\s*[:=]"
  }
}
