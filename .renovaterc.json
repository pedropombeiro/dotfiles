{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergePatch",
    ":automergeRequireAllStatusChecks",
    ":configMigration",
    ":prImmediately"
  ],
  "separateMajorMinor": true,
  "separateMinorPatch": true,
  "separateMultipleMajor": true,
  "packageRules": [
    {
      "description": "Group GitHub Actions updates weekly",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "schedule": ["before 9am on sunday"]
    },
    {
      "description": "Pin GitHub Actions to commit SHAs for security",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Use rebase strategy for automerging patch/pin/digest updates with strict checks",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "internalChecksFilter": "strict",
      "automergeStrategy": "rebase"
    },
    {
      "description": "Prefix automerge updates in MR titles",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "commitMessageSuffix": "- `AUTOMERGE`"
    },
    {
      "description": "Limit Renovate updates to monthly",
      "matchManagers": ["mise"],
      "matchPackageNames": ["npm:renovate"],
      "schedule": ["on the first day of the month"]
    },
    {
      "description": "Delay Node.js updates by 7 days for stability",
      "matchManagers": ["mise"],
      "matchPackageNames": ["node", "nodejs"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Pin Node.js version for QTS (limited runtime support)",
      "matchManagers": ["mise"],
      "matchPackageNames": ["node", "nodejs"],
      "matchFileNames": [
        ".config/mise/config.toml##distro.qts,extension.toml",
        ".config/mise/conf.d/distro-specific.toml##os.Linux,distro.qts"
      ],
      "allowedVersions": "23.7.x"
    },
    {
      "description": "Group mise github/aqua backend tools",
      "matchManagers": ["custom.regex", "mise"],
      "matchFileNames": [
        ".config/mise/config.toml**",
        ".config/mise/conf.d/**"
      ],
      "groupName": "mise backend tools"
    },
    {
      "description": "Pin Ruby on the work machine: `ruby` resolves through GitLab's asdf-gitlab-ruby plugin, whose versions.txt publishes no macos/arm64 build past 3.4.9. Newer pins fall back to a slow source compile, leaving ruby missing and silently degrading the gem: backend to system Ruby 2.6. Raise this once the manifest catches up.",
      "matchManagers": ["mise"],
      "matchPackageNames": ["ruby"],
      "matchFileNames": [".config/mise/conf.d/work.toml##class.Work"],
      "allowedVersions": "3.4.9"
    },
    {
      "description": "Compare ipinfo- prefixed tags while keeping the prefix mise needs to resolve them",
      "matchManagers": ["custom.regex", "mise"],
      "matchPackageNames": ["/^([a-z]+:)?ipinfo/cli$/"],
      "versioning": "regex:^ipinfo-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Compare gping-v prefixed tags while keeping the prefix mise needs to resolve them",
      "matchManagers": ["custom.regex", "mise"],
      "matchPackageNames": ["/^([a-z]+:)?orf/gping$/"],
      "versioning": "regex:^gping-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Group shared dua updates",
      "matchManagers": ["mise"],
      "matchPackageNames": ["/dua/"],
      "groupName": "mise shared dua"
    },
    {
      "description": "Group opencode updates",
      "matchManagers": ["custom.regex", "mise"],
      "matchPackageNames": ["/opencode/"],
      "groupName": "mise shared opencode"
    },
    {
      "description": "Group opencode npm plugin updates (after the mise opencode rule so it wins for opencode.json)",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".config/opencode/opencode.json##**"],
      "groupName": "opencode plugins",
      "groupSlug": "opencode-plugins"
    },
    {
      "description": "Group shared npm:renovate updates across all mise configs (last to ensure it overrides other groups)",
      "matchManagers": ["mise"],
      "matchPackageNames": ["/npm:renovate/"],
      "groupName": "mise shared npm:renovate",
      "groupSlug": "mise-shared-npm-renovate"
    },
    {
      "description": "Never auto-bump the gopro-dashboard-overlay fork. It is pinned to a fork-only tag (v0.134.0-whole-ride.N) carrying local patches. Under semver that tag is a prerelease of 0.134.0, so any upstream tag would rank higher and an update would silently drop the whole-ride extent patches. Re-tag the fork by hand after rebasing onto upstream.",
      "matchManagers": ["mise"],
      "matchPackageNames": ["pedropombeiro/gopro-dashboard-overlay"],
      "enabled": false
    }
  ],
  "mise": {
    "managerFilePatterns": [
      "/(^|/)\\.?mise\\.toml$/",
      "/(^|/)\\.?mise/config\\.toml$/",
      "/(^|/)\\.config/mise/config\\.toml##[^/]+$/",
      "/(^|/)\\.config/mise/config\\.toml$/",
      "/(^|/)\\.config/mise/conf\\.d/[^/]+\\.toml(##[^/]+)?$/"
    ]
  },
  "customManagers": [
    {
      "description": "mise github/aqua backend packages",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.config/mise/config\\.toml##[^/]+$/",
        "/(^|/)\\.config/mise/config\\.toml$/",
        "/(^|/)\\.config/mise/config\\.local\\.toml$/",
        "/(^|/)\\.config/mise/conf\\.d/[^/]+\\.toml(##[^/]+)?$/"
      ],
      "matchStrings": [
        "\"github:(?<depName>[^\"\\[]+)(\\[[^\\]]*\\])?\"\\s*=\\s*\"(?<currentValue>[^\"]+)\"",
        "\"aqua:(?<depName>[^\"\\[]+)(\\[[^\\]]*\\])?\"\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "description": "mise opencode inline-table package (aqua backend)",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.config/mise/config\\.toml##[^/]+$/",
        "/(^|/)\\.config/mise/config\\.toml$/",
        "/(^|/)\\.config/mise/config\\.local\\.toml$/",
        "/(^|/)\\.config/mise/conf\\.d/[^/]+\\.toml(##[^/]+)?$/"
      ],
      "matchStrings": [
        "\"opencode\"\\s*=\\s*\\{[^}]*version\\s*=\\s*\"(?<currentValue>[^\"]+)\"[^}]*\\}"
      ],
      "depNameTemplate": "anomalyco/opencode",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    },
    {
      "description": "opencode npm plugins pinned in opencode.json",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.config/opencode/opencode\\.json(##[^/]+)?$/"
      ],
      "matchStrings": [
        "\"(?<depName>(@[^\"/@]+/)?[^\"@/]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+[^\"]*)\""
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
