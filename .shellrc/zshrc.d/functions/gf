
#
# The `gf` alias fetches branches/tags from the remote, and notifying when branches have been merged

local git_cmd=git
if [[ "$PWD" == "$HOME" ]]; then
  git_cmd=yadm
fi

$git_cmd fetch --jobs=10
$git_cmd for-each-ref --format='%(refname:short) %(upstream:short) %(upstream:track)' refs/heads | awk '$2 ~ /^(origin|security)\// && $3 == "[gone]" && $1 !~ /^_/ {print $1 " has been merged!"}' | xargs -I _ hs -c 'hs.notify.new({title="Git fetch", informativeText="_"}):send(); return'
