
#
# The `gfa` fetches branches/tags from all remotes, deleting local references to remote branches that have been deleted upstream,
# and notifying when branches have been merged

git fetch --all --prune --jobs=10
git for-each-ref --format='%(refname:short) %(upstream:short) %(upstream:track)' refs/heads | awk '$2 ~ /^(origin|security)\// && $3 == "[gone]" && $1 !~ /^_/ {print $1 " has been merged!"}' | xargs -I _ hs -c 'hs.notify.new({title="Git fetch", informativeText="_"}):send(); return'
