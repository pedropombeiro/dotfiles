#!/usr/bin/env zsh

# Delete local branches whose upstream disappeared or whose work has landed.
# Branches prefixed with _ are intentionally retained.

local dry_run=false
local argument
local reset='' green='' yellow='' cyan='' bold=''

if [[ -t 1 && -z $NO_COLOR ]]; then
  reset=$'\e[0m'
  green=$'\e[32m'
  yellow=$'\e[33m'
  cyan=$'\e[36m'
  bold=$'\e[1m'
fi

for argument in "$@"; do
  case "$argument" in
    -n|--dry-run)
      dry_run=true
      ;;
    -h|--help)
      print 'Usage: git_prune [-n|--dry-run]'
      return 0
      ;;
    *)
      print -u2 "git_prune: unknown option: $argument"
      return 2
      ;;
  esac
done

local -a remotes
local remote
for remote in origin security; do
  git remote get-url "$remote" >/dev/null 2>&1 && remotes+=("$remote")
done

(( ${#remotes} )) || {
  print -u2 'git_prune: no origin or security remote configured'
  return 1
}

git fetch --prune --multiple "${remotes[@]}" || return

local default_branch
default_branch=$(git_main_branch) || return

local current_branch
current_branch=$(git branch --show-current) || return

local -a branches candidates changed_paths mr_lines
local branch upstream upstream_remote upstream_track default_ref
local remote_url remote_host remote_project encoded_branch merge_base
local mr_line mr_target landing_sha api_merge_base mr_merged
local landing_candidates limit unpushed
local work_landed glab_auth_status
local glab_auth_checked=false

branches=("${(@f)$(git for-each-ref --format='%(refname:short)' refs/heads)}")
for branch in "${branches[@]}"; do
  [[ $branch == "$current_branch" || $branch == "$default_branch" || $branch == _* ]] && continue

  upstream=$(git for-each-ref --format='%(upstream:short)' "refs/heads/$branch")
  [[ -n $upstream ]] || continue

  upstream_remote=${upstream%%/*}
  upstream_track=$(git for-each-ref --format='%(upstream:track)' "refs/heads/$branch")

  if [[ $upstream_track == *': gone]' ]]; then
    candidates+=("$branch|gone")
    print -r -- "${yellow}🗑  $branch: gone${reset}"
    continue
  fi

  default_ref="$upstream_remote/$default_branch"
  git show-ref --verify --quiet "refs/remotes/$default_ref" || continue

  if git merge-base --is-ancestor "$branch" "$default_ref"; then
    candidates+=("$branch|merged")
    print -r -- "${yellow}🗑  $branch: merged${reset}"
    continue
  fi

  # The local ref may lag behind its upstream, so judge landing by the upstream.
  if git merge-base --is-ancestor "$upstream" "$default_ref"; then
    candidates+=("$branch|merged-upstream")
    print -r -- "${yellow}🗑  $branch: merged-upstream${reset}"
    continue
  fi

  merge_base=$(git merge-base "$default_ref" "$upstream") || continue
  changed_paths=("${(@f)$(git diff --name-only "$merge_base" "$upstream")}")
  (( ${#changed_paths} )) || continue

  # If the default branch never touched these paths, the work cannot have landed.
  landing_candidates=$(git rev-list --count "$merge_base..$default_ref" -- "${changed_paths[@]}")
  if (( ! landing_candidates )); then
    print -r -- "${green}✓  $branch: active${reset}"
    continue
  fi

  remote_url=$(git remote get-url "$upstream_remote")
  remote_host=$(print -r -- "$remote_url" | sed -E 's|^[a-z+]+://||; s|^[^@]*@||; s|[:/].*$||')
  remote_project=$(print -r -- "$remote_url" | sed -E 's|^[a-z+]+://[^/]*/||; s|^[^:]*:||; s|\.git$||')

  if [[ $glab_auth_checked == false ]]; then
    glab_auth_status=$(glab auth status 2>&1)
    glab_auth_checked=true
  fi

  mr_merged=false
  if print -r -- "$glab_auth_status" | grep -q "^[[:space:]]*$remote_host$"; then
    encoded_branch=${branch//\//%2F}
    print -r -- "${cyan}🔎 $branch: checking merged MRs${reset}"
    mr_lines=("${(@f)$(glab api --hostname "$remote_host" \
      "projects/${remote_project//\//%2F}/merge_requests?source_branch=$encoded_branch&state=merged" 2>/dev/null |
      jq -r '.[] | [.target_branch, (.squash_commit_sha // ""), (.merge_commit_sha // "")] | @tsv')}")

    for mr_line in "${mr_lines[@]}"; do
      [[ -n $mr_line ]] || continue
      mr_target=${mr_line%%$'\t'*}
      landing_sha=${${mr_line#*$'\t'}%%$'\t'*}
      [[ -n $landing_sha ]] || landing_sha=${mr_line##*$'\t'}
      [[ -n $mr_target && -n $landing_sha ]] || continue

      # The MR target may have no local tracking ref, so fall back to the API.
      if git show-ref --verify --quiet "refs/remotes/$upstream_remote/$mr_target"; then
        git merge-base --is-ancestor "$landing_sha" "$upstream_remote/$mr_target" || continue
      else
        api_merge_base=$(glab api --hostname "$remote_host" \
          "projects/${remote_project//\//%2F}/repository/merge_base?refs[]=$landing_sha&refs[]=${mr_target//\//%2F}" 2>/dev/null |
          jq -r '.id // empty')
        [[ $api_merge_base == "$landing_sha" ]] || continue
      fi

      mr_merged=true
      break
    done
  fi

  # Read-only mode judges the upstream, so never drop unpushed local commits.
  limit=$(git merge-base "$default_ref" "$branch") || continue
  unpushed=$(git cherry "$upstream" "$branch" "$limit" 2>/dev/null | grep -c '^+')
  if (( unpushed )); then
    print -r -- "${green}✓  $branch: active (unpushed local work)${reset}"
    continue
  fi

  if [[ $mr_merged == true ]]; then
    candidates+=("$branch|mr-merged")
    print -r -- "${yellow}🗑  $branch: mr-merged${reset}"
    continue
  fi

  work_landed=false
  if git diff --quiet "$default_ref" "$upstream" -- "${changed_paths[@]}"; then
    work_landed=true
  fi

  if [[ $work_landed != true ]]; then
    print -r -- "${green}✓  $branch: active${reset}"
    continue
  fi

  candidates+=("$branch|work-landed")
  print -r -- "${yellow}🗑  $branch: work-landed${reset}"
done

if (( ! ${#candidates} )); then
  print -r -- "${green}✓  nothing to prune${reset}"
  return 0
fi

print -r -- "\n${bold}Branches to prune:${reset}"
for argument in "${candidates[@]}"; do
  print -r -- "${yellow}🗑  ${argument%%|*}: ${argument#*|}${reset}"
done

if [[ $dry_run == true ]]; then
  return 0
fi

for argument in "${candidates[@]}"; do
  git branch -D "${argument%%|*}" || return
done
