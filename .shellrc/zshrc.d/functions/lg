
#
# `lg` opens lazygit, invoking 'yadm enter' if needed.
# A Git repository enclosing $PWD takes precedence over the yadm repository.
#

if git rev-parse --git-dir >/dev/null 2>&1; then
  lazygit "$@"
elif [[ "$PWD" == "$HOME" || "$PWD" == "$HOME/.config" || "$PWD" == "$HOME/.config/"* ]]; then
  GIT_DIR="$HOME/.local/share/yadm/repo.git" GIT_WORK_TREE="$HOME" lazygit "$@"
else
  lazygit "$@"
fi
