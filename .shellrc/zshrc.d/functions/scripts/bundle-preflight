#!/usr/bin/env bash
#
# Fail fast before a push when the repo's lefthook pre-push hooks need Bundler
# but the local gems don't match Gemfile.lock. The hooks run in parallel, so
# without this check they all start and report raw Bundler::GemNotFound errors.
#
# Usage: bundle-preflight [git push args...]
#

set -euo pipefail

for arg in "$@"; do
  [[ "$arg" == "--no-verify" ]] && exit 0
done
[[ "${LEFTHOOK:-}" == "0" ]] && exit 0

top="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[[ -f "$top/Gemfile.lock" && -f "$top/lefthook.yml" ]] || exit 0
grep -q 'bundle exec' "$top/lefthook.yml" || exit 0

if ! (cd "$top" && mise exec -- bundle check >/dev/null 2>&1); then
  echo "bundle-preflight: local gems don't match Gemfile.lock, so pre-push hooks would fail." >&2
  echo "Run 'mise exec -- bundle install' in $top (or 'fgdku' in the GDK checkout), then retry." >&2
  exit 1
fi

# Lefthook pre-push hooks in GitLab compute changed files from
# $(git merge-base origin/master HEAD)..HEAD. When HEAD was rebased onto or
# branched from a master commit newer than the local origin/master tracking ref,
# the merge base falls back to an older ancestor and hooks lint unrelated
# upstream files.
if grep -q 'origin/master' "$top/lefthook.yml" && git -C "$top" remote get-url origin >/dev/null 2>&1; then
  user_email="$(git -C "$top" config user.email || true)"
  if ! git -C "$top" rev-parse --verify --quiet refs/remotes/origin/master >/dev/null ||
    [[ -n "$(git -C "$top" rev-list --merges -n 1 origin/master..HEAD 2>/dev/null)" ]] ||
    [[ -n "$user_email" && -n "$(git -C "$top" log --format='%ae' origin/master..HEAD 2>/dev/null | grep -Fxv "$user_email" | head -1)" ]]; then
    echo "bundle-preflight: origin/master is behind the branch base; refreshing origin/master..." >&2
    git -C "$top" fetch --no-tags origin refs/heads/master:refs/remotes/origin/master
  fi
fi
