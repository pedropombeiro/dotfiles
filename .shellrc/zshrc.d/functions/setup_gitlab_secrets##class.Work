emulate -L zsh

local session
session=$(op signin --account gitlab) || return
eval "$session" || return

local secrets_dir varname
local -a varnames=(GITLAB_TOKEN GITLAB_STAGING_TOKEN GITLAB_GDK_TOKEN)
local -a pids
local -i i result=0

{
  secrets_dir=$(mktemp -d "${TMPDIR:-/tmp}/gitlab-secrets.XXXXXXXX") || return

  for varname in $varnames; do
    echo "Fetching ${varname}..."
    op --cache item get "$varname" --vault Private --fields credential --reveal > "$secrets_dir/$varname" &
    pids+=($!)
  done

  for (( i = 1; i <= ${#pids}; i++ )); do
    if ! wait $pids[$i]; then
      print -u2 "Failed to fetch ${varnames[$i]}"
      result=1
    elif [[ ! -s "$secrets_dir/${varnames[$i]}" ]]; then
      print -u2 "Empty credential for ${varnames[$i]}"
      result=1
    fi
  done

  if (( result == 0 )); then
    for varname in $varnames; do
      export "$varname=$(<"$secrets_dir/$varname")"
    done
  fi
} always {
  [[ -z "$secrets_dir" ]] || rm -rf -- "$secrets_dir"
  op signout || result=1
  unset OP_SESSION_gitlab
}

(( result == 0 )) || return $result
echo 'Done'
