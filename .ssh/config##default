Include config.d/*

Host nas nas.home.pombei.ro
  HostName nas
  HostKeyAlgorithms +ssh-rsa,ssh-rsa-cert-v01@openssh.com
  User admin
  RequestTTY yes
  # Detect a connection broken by sleep in about 30 seconds.
  ServerAliveCountMax 2
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  PreferredAuthentications publickey
Host unifi unifi.infra.pombei.ro gateway gateway.infra.pombei.ro 192.168.16.1
  User root
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
Host switch switch.infra.pombei.ro
  User pombeiro_admin
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
Host ap ap.infra.pombei.ro ap-u6pro ap-u6pro.infra.pombei.ro
  HostName ap-u6pro
  User pombeiro_admin
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host *
  ServerAliveInterval=15
  ServerAliveCountMax=20

Host gitlab.com
  User git
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  PreferredAuthentications publickey
  ControlMaster auto
  ControlPath ~/.ssh/controlmasters/%r@%h:%p
  ControlPersist 10m
Host altssh.gitlab.com
  Port 443
  User git
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  PreferredAuthentications publickey
  ControlMaster auto
  ControlPath ~/.ssh/controlmasters/%r@%h:%p
  ControlPersist 10m
Host github.com
  AddKeysToAgent yes
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  PreferredAuthentications publickey
