{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "edit", "resource": ".shellrc/*", "effect": "allow" },
    // YADM commands (dotfiles-specific)
    { "action": "shell", "resource": "yadm add *", "effect": "allow" },
    { "action": "shell", "resource": "yadm alt", "effect": "allow" },
    { "action": "shell", "resource": "yadm blame *", "effect": "allow" },
    { "action": "shell", "resource": "yadm branch *", "effect": "allow" },
    { "action": "shell", "resource": "yadm cat-file *", "effect": "allow" },
    { "action": "shell", "resource": "yadm check-ignore *", "effect": "allow" },
    { "action": "shell", "resource": "yadm config --get-all *", "effect": "allow" },
    { "action": "shell", "resource": "yadm diff*", "effect": "allow" },
    { "action": "shell", "resource": "yadm enter *", "effect": "allow" },
    { "action": "shell", "resource": "yadm grep *", "effect": "allow" },
    { "action": "shell", "resource": "yadm list *", "effect": "allow" },
    { "action": "shell", "resource": "yadm log *", "effect": "allow" },
    { "action": "shell", "resource": "yadm ls-files*", "effect": "allow" },
    { "action": "shell", "resource": "yadm push", "effect": "allow" },
    { "action": "shell", "resource": "yadm show *", "effect": "allow" },
    { "action": "shell", "resource": "yadm status*", "effect": "allow" },
    { "action": "shell", "resource": "stylua *", "effect": "allow" }
  ]
}
